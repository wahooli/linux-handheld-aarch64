# Pinned upstream refs, shared by every product built in this repository.
#
# scripts/poll-sources.sh rewrites this file and commits it; that commit is what
# triggers a build. Edit it by hand to build sooner, or to pin back.
#
# Refs here mean the same thing to every product. Anything a product decides for
# itself -- kernel source, config fragments, series, boards, whether it wants the
# OGC layer -- lives in products/<name>.conf.
#
# Every product may also pin its own base (KERNEL_REF / BASE_VERSION in its
# conf), because the stacks rebase on unrelated cadences and a single shared base
# would let the slowest one gate the rest.

# Products to build. Each name resolves to products/<name>.conf.
# Space separated; adding one is a config change, not a code change.
PRODUCTS="handheld el2"

# ---------------------------------------------------------------------------
# Kernel bases, one per KERNEL_SOURCE a product can select
# ---------------------------------------------------------------------------

# CachyOS/linux release tag, for KERNEL_SOURCE=cachyos.
#
# THIS DECIDES THE BASE for a cachyos product: cachyos-7.2.2-1 -> base 7.2.2,
# pkgver 7.2.2.cachy1. One signed release asset (~265 MB .tar.gz plus .asc)
# holding mainline stable with CachyOS's branches already merged (bbr3, cachy,
# gaming-sched, ksm, preempt-ipi, amd-pstate, ...). Nothing is applied on top.
#
# CachyOS also tags -rc releases (cachyos-7.3-rc1-2); the poller passes over
# them, and pinning one by hand emits a note about how pacman sorts an rc pkgver.
CACHYOS_REF=cachyos-7.2.2-1

# Mainline base for KERNEL_SOURCE=kernel.org, as a bare version (7.2.2, or
# 7.3-rc1). Blank means "derive it from OGC_REF", which is what this repo did
# before products existed and is still what a product with USE_OGC=yes and no
# explicit pin gets.
KERNELORG_REF=

# ---------------------------------------------------------------------------
# Patch sources
# ---------------------------------------------------------------------------

# CachyOS/kernel-patches, for the scheduler patch a product selects with
# CACHY_SCHED. Pinned to a COMMIT, not a branch: that repo has no tags and no
# per-patch signatures, and CachyOS's own PKGBUILD reads it from `master`. A
# commit SHA is content-addressed, which is the only integrity available here.
#
# Deliberately NOT polled. Walking this forward automatically would pull
# arbitrary new scheduler code into a build; bump it by hand after reading what
# changed.
CACHY_PATCHES_REF=c3555d2ea83e22259652d5ad4b42036fd57b94f4

# OpenGamingCollective/linux release tag. Read only by a product with
# USE_OGC=yes, and only for its patches -- it does not decide any base.
#
# Nothing sets USE_OGC=yes today: CachyOS's 7.2/gaming-sched branch already
# carries the EEVDF series patches/ogc.select selects. See docs/PATCHES.md.
OGC_REF=v7.2.1-ogc3

# armada-os/armada-packages. No tags or releases exist, so this is the newest
# commit touching kernel/ as of pinning. The poller moves it.
ARMADA_REF=17f2ec7f1bbeffc58b05bbbe95700e789388d2b2

# ROCKNIX/distribution release tag. Supplement only: its patches are fetched and
# dry-run tested, never applied. See docs/PATCHES.md.
ROCKNIX_REF=20260901

# Global escape hatch, overriding every product's derived base. Empty means
# "each product derives its own", which is the normal mode. Prefer BASE_VERSION
# in a single products/<name>.conf over this -- it exists for a one-off
# `BASE_VERSION=... ./scripts/build.sh` and for the workflow input.
BASE_VERSION=
