# Pinned upstream refs, shared by every product built in this repository.
#
# scripts/poll-sources.sh rewrites this file and commits it; that commit is what
# triggers a build. Edit it by hand to build sooner, or to pin back.
#
# Anything a product decides for itself -- kernel source, config fragments,
# series, boards, its own base pin -- lives in products/<name>.conf.

# Products to build. Each name resolves to products/<name>.conf.
PRODUCTS="handheld el2"

# ---------------------------------------------------------------------------
# Kernel bases, one per KERNEL_SOURCE a product can select
# ---------------------------------------------------------------------------

# CachyOS/linux release tag, for KERNEL_SOURCE=cachyos. Decides the base:
# cachyos-7.2.2-1 -> base 7.2.2, pkgver 7.2.2.cachy1. One signed asset holding
# mainline stable with CachyOS's branches already merged; nothing on top.
#
# They also tag -rc releases, which the poller passes over. Pinning one by hand
# emits a note about how pacman sorts an rc pkgver.
CACHYOS_REF=cachyos-7.2.3-2

# Mainline base for KERNEL_SOURCE=kernel.org, as a bare version (7.2.2, or
# 7.3-rc1). Blank derives it from OGC_REF, for a product with USE_OGC=yes and no
# explicit pin.
KERNELORG_REF=

# ---------------------------------------------------------------------------
# Patch sources
# ---------------------------------------------------------------------------

# CachyOS/kernel-patches, for the scheduler patch a product selects with
# CACHY_SCHED. Pinned to a commit, not a branch: that repo has no tags and no
# per-patch signatures, so a commit SHA is the only integrity available.
#
# Not polled -- walking it forward automatically would pull arbitrary new
# scheduler code into a build. Bump by hand after reading what changed.
CACHY_PATCHES_REF=c3555d2ea83e22259652d5ad4b42036fd57b94f4

# OpenGamingCollective/linux release tag. Read only by a product with
# USE_OGC=yes, and only for its patches -- it decides no base. Nothing sets it
# today: CachyOS's tree already carries the series ogc.select selects.
OGC_REF=v7.2.1-ogc3

# armada-os/armada-packages. No tags or releases exist, so this is the newest
# commit touching kernel/ as of pinning. The poller moves it.
ARMADA_REF=17f2ec7f1bbeffc58b05bbbe95700e789388d2b2

# ROCKNIX/distribution release tag. Its patches are fetched and dry-run tested,
# never applied. See docs/PATCHES.md.
ROCKNIX_REF=20260901

# Global escape hatch, overriding every product's derived base. Empty is the
# normal mode. Prefer BASE_VERSION in one products/<name>.conf -- this exists for
# a one-off `BASE_VERSION=... ./scripts/build.sh` and for the workflow input.
BASE_VERSION=
