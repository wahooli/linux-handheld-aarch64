# Pinned upstream refs.
#
# scripts/poll-sources.sh rewrites this file and commits it; that commit is what
# triggers a build. Edit it by hand to build sooner, or to pin back.

# OpenGamingCollective/linux release tag.
#
# THIS DECIDES THE MAINLINE BASE: v7.2.1-ogc3 -> linux-7.2.1. There is no second
# place recording the kernel version, deliberately -- the old arch-arm64 package
# kept BASE.env and the PKGBUILD's _srcver in sync by hand and they drifted.
OGC_REF=v7.2.1-ogc3

# armada-os/armada-packages. No tags or releases exist, so this is the newest
# commit touching kernel/ as of pinning. The poller moves it.
ARMADA_REF=68297cd8c661572256a0f93431d1ad11e982906e

# ROCKNIX/distribution release tag. Supplement only: its patches are fetched and
# dry-run tested, never applied. See docs/PATCHES.md.
ROCKNIX_REF=20260801

# Devices to build for. Each name resolves to devices/<name>.conf.
# Space separated; adding one is a config change, not a code change.
DEVICES="odin3"

# Escape hatch. Empty means "derive the base from OGC_REF", which is the normal
# mode. Set an explicit version (e.g. 7.2.1) to hold the base still when OGC
# moves to a mainline the device stack cannot follow yet -- see README.md.
BASE_VERSION=
