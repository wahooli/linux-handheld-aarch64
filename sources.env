# Pinned upstream refs shared by every product; scripts/poll-sources.sh bumps and commits them.
# https://github.com/wahooli/linux-handheld-aarch64/wiki/Building-and-Publishing#upstream-refs-and-polling

PRODUCTS="handheld el2"

# --- kernel bases, one per KERNEL_SOURCE ---

# Decides the base: cachyos-7.2.2-1 -> pkgver 7.2.2.cachy1. The poller skips -rc and LTS tags.
CACHYOS_REF=cachyos-7.3.3-1

# Bare version (7.2.2, 7.3-rc1); blank derives it from OGC_REF for a USE_OGC=yes product.
KERNELORG_REF=

# --- patch sources ---

# A commit: no tags or signatures upstream. poll-sources.sh moves it with CACHYOS_REF.
CACHY_PATCHES_REF=f0eade177f5be4a6da4846a60bb3baa985dfd839

# Patches only, for a USE_OGC=yes product (none today); decides no base.
OGC_REF=v7.2.1-ogc3

# armada-os/armada, no tags: newest commit touching packages/kernel/, moved by the poller.
ARMADA_REF=56f8b02846855b4d1cc0e7348de9b0e3cb494765

# Fallback for armada-named patches, and the never-applied staged set.
ROCKNIX_REF=20261101

# Global base pin over every product; normally empty. Prefer BASE_VERSION in a product conf.
BASE_VERSION=
