From 9759767e2ab5f4a6a291d8cf8d1fa651d572965e Mon Sep 17 00:00:00 2001
From: Waltteri Hooli <wahooli@localhost>
Date: Fri, 14 Aug 2026 14:42:13 +0300
Subject: [PATCH 19/28] local: arm64: dts: qcom: x1-el2: store RTC offset in
 SDAM (UEFI vars dead at EL2)

---
 arch/arm64/boot/dts/qcom/x1-el2.dtso | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1-el2.dtso b/arch/arm64/boot/dts/qcom/x1-el2.dtso
index 0886951bc..d5e6f8fbe 100644
--- a/arch/arm64/boot/dts/qcom/x1-el2.dtso
+++ b/arch/arm64/boot/dts/qcom/x1-el2.dtso
@@ -74,3 +74,26 @@ &remoteproc_cdsp {
 &sbsa_watchdog {
 	status = "disabled";
 };
+
+/*
+ * local: at EL2 (Secure Launch) UEFI variable services are dead, so the RTC's
+ * qcom,uefi-rtc-info offset backend defers forever. Store the offset in SDAM
+ * instead, like sc8280xp boards do. No pmk8550 platform documents an RTC cell,
+ * so 0x7c-0x7f was chosen empirically: zero and stable across EL1/EL2 dumps,
+ * tail of the 0x40-0x7f window, farthest from observed firmware activity
+ * (counters at 0x5a-0x61, config at 0x62-0x6f, reboot-reason at 0x48).
+ * EL1 boots keep using the UEFI variable (this overlay never applies there).
+ */
+&pmk8550_rtc {
+	nvmem-cells = <&rtc_offset>;
+	nvmem-cell-names = "offset";
+};
+
+&pmk8550_sdam_2 {
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	rtc_offset: rtc-offset@7c {
+		reg = <0x7c 0x4>;
+	};
+};
