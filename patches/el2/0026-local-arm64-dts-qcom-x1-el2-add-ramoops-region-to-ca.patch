From e55f6443df29a8a5df4e64fa9906dce9aaec7486 Mon Sep 17 00:00:00 2001
From: Waltteri Hooli <wahooli@localhost>
Date: Fri, 14 Aug 2026 18:32:53 +0300
Subject: [PATCH 26/28] local: arm64: dts: qcom: x1-el2: add ramoops region to
 capture the intermittent freeze

---
 arch/arm64/boot/dts/qcom/x1-el2.dtso | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1-el2.dtso b/arch/arm64/boot/dts/qcom/x1-el2.dtso
index 283d88761..40e432f83 100644
--- a/arch/arm64/boot/dts/qcom/x1-el2.dtso
+++ b/arch/arm64/boot/dts/qcom/x1-el2.dtso
@@ -113,3 +113,24 @@ rtc_offset: rtc-offset@7c {
 &scm {
 	qcom,shm-bridge-vmid = <QCOM_SCM_VMID_SELF_OWNER>;
 };
+
+/*
+ * local: persistent console/oops store to diagnose the intermittent EL2
+ * freeze + firmware self-reset, which never reaches the journal. 2 MiB in
+ * the reserved-memory gap after q6-wpss-dtb (next firmware region starts at
+ * 0xd8000000). Survives the reset only if XBL leaves DDR intact on warm
+ * reset -- untested until the first captured crash. Read via /sys/fs/pstore.
+ * Needs CONFIG_PSTORE_RAM=y + CONFIG_PSTORE_CONSOLE=y.
+ */
+&{/reserved-memory} {
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	ramoops@91400000 {
+		compatible = "ramoops";
+		reg = <0x0 0x91400000 0x0 0x200000>;
+		console-size = <0x100000>;
+		record-size = <0x10000>;
+		pmsg-size = <0x10000>;
+	};
+};
