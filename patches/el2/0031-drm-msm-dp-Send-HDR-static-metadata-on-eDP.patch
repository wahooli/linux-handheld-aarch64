-void msm_dp_panel_enable_vsc_sdp(struct msm_dp_panel *msm_dp_panel, struct dp_sdp *vsc_sdp)
+static int msm_dp_panel_setup_vsc_sdp_yuv_420(struct msm_dp_panel *msm_dp_panel)
 {
 	struct msm_dp_panel_private *panel =
 		container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
+	struct msm_dp_display_mode *msm_dp_mode = &msm_dp_panel->msm_dp_mode;
+	struct drm_dp_vsc_sdp vsc_sdp_data;
+	struct dp_sdp vsc_sdp;
+	ssize_t len;
+
+	memset(&vsc_sdp_data, 0, sizeof(vsc_sdp_data));
+
+	/* VSC SDP header as per table 2-118 of DP 1.4 specification */
+	vsc_sdp_data.sdp_type = DP_SDP_VSC;
+	vsc_sdp_data.revision = 0x05;
+	vsc_sdp_data.length = 0x13;
+
+	/* VSC SDP Payload for DB16 */
+	vsc_sdp_data.pixelformat = DP_PIXELFORMAT_YUV420;
+	vsc_sdp_data.colorimetry = DP_COLORIMETRY_DEFAULT;
+
+	/* VSC SDP Payload for DB17 */
+	vsc_sdp_data.bpc = msm_dp_mode->bpp / 3;
+	vsc_sdp_data.dynamic_range = DP_DYNAMIC_RANGE_CTA;
+
+	/* VSC SDP Payload for DB18 */
+	vsc_sdp_data.content_type = DP_CONTENT_TYPE_GRAPHICS;
+
+	len = drm_dp_vsc_sdp_pack(&vsc_sdp_data, &vsc_sdp);
+	if (len < 0) {
+		DRM_ERROR("unable to pack vsc sdp\n");
+		return len;
+	}
+
+	msm_dp_panel_send_sdp(panel, &vsc_sdp, MMSS_DP_GENERIC0_0);
+
+	return 0;
+}
+
+/*
+ * DP carries HDR static metadata as a CTA-861 Dynamic Range and Mastering
+ * infoframe wrapped in an SDP (DP 1.4 section 2.2.5.1). Pack it here, at
+ * atomic_enable time where the connector state is reachable, so the link
+ * bring-up path only has to copy it into the hardware.
+ */
+int msm_dp_panel_set_hdr_metadata(struct msm_dp_panel *msm_dp_panel,
+				  const struct drm_connector_state *conn_state)
+{
+	struct msm_dp_panel_private *panel;
+	struct dp_sdp *sdp = &msm_dp_panel->hdr_sdp;
+	u8 buf[HDMI_INFOFRAME_SIZE(DRM)];
+	struct hdmi_drm_infoframe frame;
+	ssize_t len;
+	int rc;
+
+	panel = container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
+
+	msm_dp_panel->hdr_sdp_valid = false;
+
+	if (!conn_state || !conn_state->hdr_output_metadata)
+		return 0;
+
+	rc = drm_hdmi_infoframe_set_hdr_metadata(&frame, conn_state);
+	if (rc) {
+		drm_dbg_dp(panel->drm_dev, "failed to set hdr metadata: %d\n", rc);
+		return rc;
+	}
+
+	len = hdmi_drm_infoframe_pack_only(&frame, buf, sizeof(buf));
+	if (len < 0) {
+		drm_dbg_dp(panel->drm_dev, "failed to pack hdr infoframe: %zd\n", len);
+		return len;
+	}
+
+	memset(sdp, 0, sizeof(*sdp));
+
+	sdp->sdp_header.HB0 = 0;
+	sdp->sdp_header.HB1 = HDMI_INFOFRAME_TYPE_DRM;
+	/* least significant eight bits of (data byte count - 1) */
+	sdp->sdp_header.HB2 = 0x1d;
+	/* infoframe SDP version in [7:2], CTA payload length in [1:0] */
+	sdp->sdp_header.HB3 = 0x13 << 2;
+
+	/* the CTA header's first byte is implied by HB1, so db starts at byte 2 */
+	sdp->db[0] = frame.version;
+	sdp->db[1] = frame.length;
+	memcpy(&sdp->db[2], &buf[HDMI_INFOFRAME_HEADER_SIZE], HDMI_DRM_INFOFRAME_SIZE);
+
+	msm_dp_panel->hdr_sdp_valid = true;
+
+	return 0;
+}
+
+/*
+ * The YUV420 VSC SDP and the HDR infoframe live in different register blocks --
+ * GENERIC0 and VSCEXT respectively -- so they are independent and either, both
+ * or neither may be enabled.
+ */
+static void msm_dp_panel_setup_sdps(struct msm_dp_panel *msm_dp_panel)
+{
+	struct msm_dp_panel_private *panel =
+		container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
+	bool send_vsc = msm_dp_panel->msm_dp_mode.out_fmt_is_yuv_420;
+	bool send_hdr = msm_dp_panel->hdr_sdp_valid;
 	u32 cfg, cfg2, misc;
 
+	if (!send_vsc && !send_hdr)
+		return;
+
 	cfg = msm_dp_read_link(panel, MMSS_DP_SDP_CFG);
 	cfg2 = msm_dp_read_link(panel, MMSS_DP_SDP_CFG2);
 	misc = msm_dp_read_link(panel, REG_DP_MISC1_MISC0);
 
-	cfg |= GEN0_SDP_EN;
-	msm_dp_write_link(panel, MMSS_DP_SDP_CFG, cfg);
+	if (send_vsc) {
+		cfg |= GEN0_SDP_EN;
+		cfg2 |= GENERIC0_SDPSIZE_VALID;
+	}
+
+	if (send_hdr) {
+		cfg |= VSCEXT_SDP_EN;
+		cfg2 |= EXTN_SDPSIZE_VALID;
+	}
 
-	cfg2 |= GENERIC0_SDPSIZE_VALID;
+	msm_dp_write_link(panel, MMSS_DP_SDP_CFG, cfg);
 	msm_dp_write_link(panel, MMSS_DP_SDP_CFG2, cfg2);
 
-	msm_dp_panel_send_vsc_sdp(panel, vsc_sdp);
+	if (send_vsc)
+		msm_dp_panel_setup_vsc_sdp_yuv_420(msm_dp_panel);
 
-	/* indicates presence of VSC (BIT(6) of MISC1) */
-	misc |= DP_MISC1_VSC_SDP;
+	if (send_hdr)
+		msm_dp_panel_send_sdp(panel, &msm_dp_panel->hdr_sdp, MMSS_DP_VSCEXT_0);
 
-	drm_dbg_dp(panel->drm_dev, "vsc sdp enable=1\n");
+	/*
+	 * Written after the payloads: BIT(6) of MISC1 tells the sink to take
+	 * colorimetry from the VSC SDP instead of MSA, which is only true once
+	 * one has actually been sent. The HDR infoframe is a separate SDP and
+	 * must not claim to be one.
+	 */
+	if (send_vsc) {
+		misc |= DP_MISC1_VSC_SDP;
+		msm_dp_write_link(panel, REG_DP_MISC1_MISC0, misc);
+	}
 
-	pr_debug("misc settings = 0x%x\n", misc);
-	msm_dp_write_link(panel, REG_DP_MISC1_MISC0, misc);
+	drm_dbg_dp(panel->drm_dev, "vsc sdp enable=%d hdr sdp enable=%d\n",
+		   send_vsc, send_hdr);
 
 	msm_dp_panel_update_sdp(panel);
 }
 
