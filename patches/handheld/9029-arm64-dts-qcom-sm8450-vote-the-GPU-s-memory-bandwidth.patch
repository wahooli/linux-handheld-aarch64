 				};
 
 				opp-350000000 {
 					opp-hz = /bits/ 64 <350000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS>;
+					opp-peak-kBps = <2136718>;
 				};
 
 				opp-317000000 {
 					opp-hz = /bits/ 64 <317000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS>;
+					opp-peak-kBps = <1761718>;
 				};
 
 				opp-285000000 {
 					opp-hz = /bits/ 64 <285000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS_D1>;
