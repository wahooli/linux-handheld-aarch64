From: Waltteri Hooli <1420194+wahooli@users.noreply.github.com>
Subject: [PATCH] usb: xhci-pci-renesas: reload the firmware on resume

A uPD720201/2 without an EEPROM keeps its firmware in RAM only, so a
power cycle across system sleep leaves it without one and the xHCI core
resumes a dead controller. On the AYANEO Pocket VERT that power cycle is
every s2idle: the built-in gamepad sits behind a uPD720201 on PCIe1, and
pcie-qcom now tears the root complex down and powers the endpoint off
through pwrctrl.

Run the probe's firmware check again before the xHCI resume. With the
firmware still running it returns at once; otherwise it downloads the
image again, from the firmware cache filled before suspend.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
--- a/drivers/usb/host/xhci-pci-renesas.c
+++ b/drivers/usb/host/xhci-pci-renesas.c
@@ -639,6 +639,25 @@
 	return xhci_pci_common_probe(dev, id);
 }
 
+#ifdef CONFIG_PM_SLEEP
+/*
+ * Without an EEPROM the firmware lives only in the controller's RAM, and
+ * pcie-qcom powers the endpoint off for s2idle. Load it again before the
+ * xHCI core resumes; a running firmware is left alone.
+ */
+static int renesas_xhci_resume(struct device *dev)
+{
+	int err = renesas_xhci_check_request_fw(to_pci_dev(dev), NULL);
+
+	if (err)
+		dev_warn(dev, "firmware reload on resume failed: %d\n", err);
+	return usb_hcd_pci_pm_ops.resume(dev);
+}
+#endif
+
+/* usb_hcd_pci_pm_ops with the resume above, filled in at module init */
+static struct dev_pm_ops renesas_xhci_pm_ops;
+
 static const struct pci_device_id pci_ids[] = {
 	{ PCI_DEVICE(PCI_VENDOR_ID_RENESAS, 0x0014) },
 	{ PCI_DEVICE(PCI_VENDOR_ID_RENESAS, 0x0015) },
@@ -655,10 +674,27 @@
 
 	.shutdown = 	usb_hcd_pci_shutdown,
 	.driver = {
-		.pm = pm_ptr(&usb_hcd_pci_pm_ops),
+		.pm = pm_ptr(&renesas_xhci_pm_ops),
 	},
 };
-module_pci_driver(xhci_renesas_pci_driver);
+
+static int __init xhci_renesas_init(void)
+{
+#ifdef CONFIG_PM
+	renesas_xhci_pm_ops = usb_hcd_pci_pm_ops;
+#endif
+#ifdef CONFIG_PM_SLEEP
+	renesas_xhci_pm_ops.resume = renesas_xhci_resume;
+#endif
+	return pci_register_driver(&xhci_renesas_pci_driver);
+}
+module_init(xhci_renesas_init);
+
+static void __exit xhci_renesas_exit(void)
+{
+	pci_unregister_driver(&xhci_renesas_pci_driver);
+}
+module_exit(xhci_renesas_exit);
 
 MODULE_DESCRIPTION("Renesas xHCI PCI Host Controller Driver");
 MODULE_FIRMWARE(RENESAS_FW_NAME);
