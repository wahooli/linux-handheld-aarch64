From: Waltteri Hooli <1420194+wahooli@users.noreply.github.com>
Subject: [PATCH] media: iris: add SM8450 support

SM8450 and SM8475 have SM8250's iris2 VPU with four pipes, but their
firmware speaks the gen2 HFI: Qualcomm's driver binds them as
msm-vidc-waipio on its iris2 variant and loads vpu20_4v. Add them as
SM8250's platform with a gen2 firmware description, taking buffer sizes
as for SC7280's gen2 firmware, and MXC rather than MX as the OPP rail,
as their video clock controller runs from MXC and MMCX.

Their firmware (video-firmware.2.4) is an early gen2 one:

- It takes HFI_CMD_RESUME without a payload. Sent HFI_CMD_SETTINGS_CHANGE
  as one, it answers with an information flag instead of resuming, holds
  the bitstream after the resolution change and never decodes.
  Qualcomm's driver sends no payload.

- A settings change before the first frame pauses both ports, also when
  the client started its capture queue before the stream. Steam's
  streaming client does that and never answers the source change event,
  so nothing resumed. When nothing has been decoded yet and the stream
  fits the capture format, resume both ports from the driver, as the
  client's capture streamon would.

- It then hands back one empty capture buffer flagged LAST for that
  settings change. Taken as the end of a drain, it stopped the session
  after one frame; queue it again instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
--- a/drivers/media/platform/qcom/iris/iris_common.c
+++ b/drivers/media/platform/qcom/iris/iris_common.c
@@ -6,6 +6,7 @@
 #include <media/v4l2-mem2mem.h>
 
 #include "iris_common.h"
+#include "iris_buffer.h"
 #include "iris_ctrls.h"
 #include "iris_instance.h"
 #include "iris_power.h"
@@ -155,6 +156,33 @@
 	return iris_inst_change_sub_state(inst, clear_sub_state, 0);
 }
 
+int iris_resume_first_ipsc(struct iris_inst *inst)
+{
+	const struct iris_hfi_session_ops *hfi_ops = inst->hfi_session_ops;
+	int ret;
+
+	ret = iris_alloc_and_queue_input_int_bufs(inst);
+	if (ret)
+		return ret;
+	ret = iris_set_stage(inst, STAGE);
+	if (ret)
+		return ret;
+	ret = iris_set_pipe(inst, PIPE);
+	if (ret)
+		return ret;
+	ret = hfi_ops->session_resume_drc(inst, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+	if (ret)
+		return ret;
+	ret = hfi_ops->session_resume_drc(inst, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+	if (ret)
+		return ret;
+
+	inst->auto_resumed = true;
+
+	return iris_inst_change_sub_state(inst, IRIS_INST_SUB_FIRST_IPSC |
+					  IRIS_INST_SUB_DRC | IRIS_INST_SUB_INPUT_PAUSE, 0);
+}
+
 static void iris_flush_deferred_buffers(struct iris_inst *inst,
 					enum iris_buffer_type type)
 {
--- a/drivers/media/platform/qcom/iris/iris_common.h
+++ b/drivers/media/platform/qcom/iris/iris_common.h
@@ -13,6 +13,7 @@
 void iris_set_ts_metadata(struct iris_inst *inst, struct vb2_v4l2_buffer *vbuf);
 int iris_process_streamon_input(struct iris_inst *inst);
 int iris_process_streamon_output(struct iris_inst *inst);
+int iris_resume_first_ipsc(struct iris_inst *inst);
 int iris_session_streamoff(struct iris_inst *inst, u32 plane);
 
 #endif
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2_command.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2_command.c
@@ -1179,6 +1179,7 @@
 {
 	struct iris_inst_hfi_gen2 *inst_hfi_gen2 = to_iris_inst_hfi_gen2(inst);
 	u32 payload = HFI_CMD_SETTINGS_CHANGE;
+	bool none = inst->core->iris_platform_data->early_gen2_fw;
 
 	iris_hfi_gen2_packet_session_command(inst,
 					     HFI_CMD_RESUME,
@@ -1186,9 +1187,9 @@
 					     HFI_HOST_FLAGS_INTR_REQUIRED),
 					     iris_hfi_gen2_get_port(inst, plane),
 					     inst->session_id,
-					     HFI_PAYLOAD_U32,
-					     &payload,
-					     sizeof(u32));
+					     none ? HFI_PAYLOAD_NONE : HFI_PAYLOAD_U32,
+					     none ? NULL : &payload,
+					     none ? 0 : sizeof(u32));
 
 	return iris_hfi_queue_cmd_write(inst->core, inst_hfi_gen2->packet,
 					inst_hfi_gen2->packet->size);
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c
@@ -5,6 +5,7 @@
 
 #include <media/v4l2-mem2mem.h>
 
+#include "iris_common.h"
 #include "iris_hfi_gen2.h"
 #include "iris_hfi_gen2_defines.h"
 #include "iris_hfi_gen2_packet.h"
@@ -354,6 +355,22 @@
 	bool found = false;
 	int ret;
 
+	/*
+	 * After a resume by the driver, the firmware hands back one empty buffer
+	 * flagged LAST for the settings change: queue it again, it ends nothing.
+	 */
+	if (inst->auto_resumed && !hfi_buffer->data_size &&
+	    hfi_buffer->flags & (HFI_BUF_FW_FLAG_LAST | HFI_BUF_FW_FLAG_PSC_LAST)) {
+		v4l2_m2m_for_each_dst_buf_safe(m2m_ctx, m2m_buffer, n) {
+			buf = to_iris_buffer(&m2m_buffer->vb);
+			if (buf->index == hfi_buffer->index &&
+			    buf->device_addr == hfi_buffer->base_address) {
+				inst->auto_resumed = false;
+				return inst->hfi_session_ops->session_queue_buf(inst, buf);
+			}
+		}
+	}
+
 	if (hfi_buffer->flags & HFI_BUF_FW_FLAG_LAST) {
 		ret = iris_inst_sub_state_change_drain_last(inst);
 		if (ret)
@@ -667,6 +684,8 @@
 static int iris_hfi_gen2_handle_src_change(struct iris_inst *inst,
 					   struct iris_hfi_packet *pkt)
 {
+	struct v4l2_pix_format_mplane *dst = &inst->fmt_dst->fmt.pix_mp;
+	u32 width = dst->width, height = dst->height;
 	int ret;
 
 	if (pkt->port != HFI_PORT_BITSTREAM)
@@ -679,6 +698,16 @@
 	iris_hfi_gen2_read_input_subcr_params(inst);
 	iris_vdec_src_change(inst);
 
+	/*
+	 * A client that started its capture queue before the stream (Steam's
+	 * streaming client) does not answer the event: when nothing has been
+	 * decoded and the stream fits its buffers, resume as its streamon would.
+	 */
+	if (inst->core->iris_platform_data->early_gen2_fw && !inst->sequence_cap &&
+	    vb2_is_streaming(v4l2_m2m_get_dst_vq(inst->m2m_ctx)) &&
+	    dst->width <= width && dst->height <= height)
+		return iris_resume_first_ipsc(inst);
+
 	return 0;
 }
 
--- a/drivers/media/platform/qcom/iris/iris_instance.h
+++ b/drivers/media/platform/qcom/iris/iris_instance.h
@@ -67,6 +67,7 @@
  * @metadata_idx: index for metadata buffer
  * @codec: codec type
  * @last_buffer_dequeued: a flag to indicate that last buffer is sent by driver
+ * @auto_resumed: resumed by the driver after the first settings change
  * @last_buf_ns: start time of received input buffer for current one second FPS window
  * @frame_counter: input buffer counter for current one second FPS window
  * @frame_rate: frame rate of current instance
@@ -114,6 +115,7 @@
 	u32				metadata_idx;
 	u32				codec;
 	bool				last_buffer_dequeued;
+	bool				auto_resumed;
 	u64				last_buf_ns;
 	u32				frame_counter;
 	u32				frame_rate;
--- a/drivers/media/platform/qcom/iris/iris_platform_common.h
+++ b/drivers/media/platform/qcom/iris/iris_platform_common.h
@@ -58,6 +58,7 @@
 extern const struct iris_platform_data qcs8300_data;
 extern const struct iris_platform_data sc7280_data;
 extern const struct iris_platform_data sm8250_data;
+extern const struct iris_platform_data sm8450_data;
 extern const struct iris_platform_data sm8550_data;
 extern const struct iris_platform_data sm8650_data;
 extern const struct iris_platform_data sm8750_data;
@@ -320,6 +321,12 @@
 	u32 tz_cp_config_data_size;
 	u32 num_vpp_pipe;
 	bool no_aon;
+	/*
+	 * Gen2 firmware of SM8450's generation: RESUME takes no payload, and a
+	 * settings change before the first frame pauses both ports even when the
+	 * capture queue already runs.
+	 */
+	bool early_gen2_fw;
 	u32 max_session_count;
 	/* max number of macroblocks per frame supported */
 	u32 max_core_mbpf;
--- a/drivers/media/platform/qcom/iris/iris_platform_vpu2.c
+++ b/drivers/media/platform/qcom/iris/iris_platform_vpu2.c
@@ -41,6 +41,12 @@
 	.fwname = "qcom/vpu/vpu20_p4.mbn",
 };
 
+static const struct iris_firmware_desc iris_vpu20_p4_gen2_desc = {
+	.firmware_data = &iris_hfi_gen2_data,
+	.get_vpu_buffer_size = iris_vpu33_buf_size,
+	.fwname = "qcom/vpu/vpu20_p4_gen2.mbn",
+};
+
 static const u32 iris_fmts_vpu2_dec[] = {
 	[IRIS_FMT_H264] = V4L2_PIX_FMT_H264,
 	[IRIS_FMT_HEVC] = V4L2_PIX_FMT_HEVC,
@@ -68,6 +74,8 @@
 
 static const char * const iris_pmdomain_table_vpu2[] = { "venus", "vcodec0" };
 
+static const char * const sm8450_opp_pd_table[] = { "mxc", "mmcx" };
+
 static const struct tz_cp_config tz_cp_config_vpu2[] = {
 	{
 		.cp_start = 0,
@@ -161,5 +169,35 @@
 	.num_vpp_pipe = 4,
 	.max_session_count = 16,
 	.max_core_mbpf = NUM_MBS_8K,
+	.max_core_mbps = ((7680 * 4320) / 256) * 60,
+};
+
+const struct iris_platform_data sm8450_data = {
+	.firmware_desc_gen2 = &iris_vpu20_p4_gen2_desc,
+	.vpu_ops = &iris_vpu2_ops,
+	.icc_tbl = iris_icc_info_vpu2,
+	.icc_tbl_size = ARRAY_SIZE(iris_icc_info_vpu2),
+	.clk_rst_tbl = iris_clk_reset_table_vpu2,
+	.clk_rst_tbl_size = ARRAY_SIZE(iris_clk_reset_table_vpu2),
+	.bw_tbl_dec = sm8250_bw_table_dec,
+	.bw_tbl_dec_size = ARRAY_SIZE(sm8250_bw_table_dec),
+	.pmdomain_tbl = iris_pmdomain_table_vpu2,
+	.pmdomain_tbl_size = ARRAY_SIZE(iris_pmdomain_table_vpu2),
+	.opp_pd_tbl = sm8450_opp_pd_table,
+	.opp_pd_tbl_size = ARRAY_SIZE(sm8450_opp_pd_table),
+	.clk_tbl = sm8250_clk_table,
+	.clk_tbl_size = ARRAY_SIZE(sm8250_clk_table),
+	.opp_clk_tbl = sm8250_opp_clk_table,
+	/* Upper bound of DMA address range */
+	.dma_mask = 0xe0000000 - 1,
+	.inst_iris_fmts = iris_fmts_vpu2_dec,
+	.inst_iris_fmts_size = ARRAY_SIZE(iris_fmts_vpu2_dec),
+	.inst_caps = &platform_inst_cap_vpu2,
+	.tz_cp_config_data = tz_cp_config_vpu2,
+	.tz_cp_config_data_size = ARRAY_SIZE(tz_cp_config_vpu2),
+	.early_gen2_fw = true,
+	.num_vpp_pipe = 4,
+	.max_session_count = 16,
+	.max_core_mbpf = NUM_MBS_8K,
 	.max_core_mbps = ((7680 * 4320) / 256) * 60,
 };
--- a/drivers/media/platform/qcom/iris/iris_probe.c
+++ b/drivers/media/platform/qcom/iris/iris_probe.c
@@ -373,6 +373,10 @@
 		.data = &sm8250_data,
 	},
 	{
+		.compatible = "qcom,sm8450-iris",
+		.data = &sm8450_data,
+	},
+	{
 		.compatible = "qcom,sm8550-iris",
 		.data = &sm8550_data,
 	},
