From: Waltteri Hooli <1420194+wahooli@users.noreply.github.com>
Subject: [PATCH] arm64: dts: qcom: cq8725s-ayn: Wi-Fi PMU rails, unused WSA
 macros, no stick deadzone

armada's Odin 3 board deltas since 9000's snapshot (armada-packages
c6aa27afe2c3), from armada packages/kernel/dts/cq8725s-ayn-common.dtsi.patch
at d2bcf6fd3343:

  - The four Wi-Fi PMU rails (vreg_s4d_0p85, vreg_s5f_0p85, vreg_l2f_1p2,
    vreg_l3f_1p8) are always on: re-enabling them at resume can hang the SoC
    (armada d48ee05953).
  - The WSA macros are disabled. The speakers are on I2S; bound WSA macros
    keep the ADSP waking (armada 0a201e5422).
  - No driver-side stick deadzone; Steam applies its own (armada 45b659e99b).

Not taken from the same delta:

  - pcieport0 WAKE# as active low. It is the right polarity, and with it
    suspend holds without arch-arm64's 70-handheld-pcie-wakeup.rules. But
    without armada's PCIe power-management patches (0522 and the SM8750
    PCIe GDSC/SoCCP work, not carried here) the Wi-Fi data path stalls
    within minutes: "failed to flush transmit queue, data pkts pending 1",
    then "Connection to AP lost" and re-association loops that toggling
    Wi-Fi does not clear. The same kernel with only this flag back to active
    high held (checked on hardware 2026-10-22). The inverted polarity keeps
    the link awake, which is evidently what this series relies on; take the
    fix together with those patches.
  - The codec rails' regulator-state-mem and the SoCCP firmware-name. Both
    are s2idle work that needs driver patches this series does not carry
    (armada 0523-0526, 0556).

---
--- a/arch/arm64/boot/dts/qcom/cq8725s-ayn-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/cq8725s-ayn-common.dtsi
@@ -302,6 +302,7 @@
 		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
 		bt-enable-gpios = <&pm8550ve_f_gpios 3 GPIO_ACTIVE_HIGH>;

+		/* Re-enabling these four rails at resume can hang the SoC. */
 		vddio-supply = <&vreg_l3f_1p8>;
 		vddio1p2-supply = <&vreg_l2f_1p2>;
 		vddaon-supply = <&vreg_s4d_0p85>;
@@ -580,6 +581,7 @@
 			regulator-name = "vreg_s4d_0p85";
 			regulator-min-microvolt = <852000>;
 			regulator-max-microvolt = <1036000>;
+			regulator-always-on;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};

@@ -628,6 +630,7 @@
 			regulator-name = "vreg_s5f_0p85";
 			regulator-min-microvolt = <852000>;
 			regulator-max-microvolt = <1000000>;
+			regulator-always-on;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};

@@ -645,6 +648,7 @@
 			regulator-name = "vreg_l2f_1p2";
 			regulator-min-microvolt = <1200000>;
 			regulator-max-microvolt = <1200000>;
+			regulator-always-on;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 			regulator-allow-set-load;
 			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
@@ -655,6 +659,7 @@
 			regulator-name = "vreg_l3f_1p8";
 			regulator-min-microvolt = <1800000>;
 			regulator-max-microvolt = <1800000>;
+			regulator-always-on;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 			regulator-allow-set-load;
 			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
@@ -954,6 +959,15 @@
 	qcom,dmic-sample-rate = <4800000>;
 };

+/* Unused (I2S speakers); bound WSA macros keep the ADSP waking in s2idle */
+&lpass_wsa2macro {
+	status = "disabled";
+};
+
+&lpass_wsamacro {
+	status = "disabled";
+};
+
 &mdss {
 	status = "okay";
 };
@@ -1414,7 +1428,6 @@
 		compatible = "gamepad,rsinput";
 		rumble-haptics;
 		axis-range = <1024>;
-		axis-deadzone = <70>;

 		gamepad-name = "AYN Odin3 Gamepad";
 		gamepad-bus = <0x0003>;
