# Inherited debug instrumentation with a runtime cost; nothing board-specific.

# _IRQSOFF falls out with DEBUG_VM; listed so the verification accounts for it.
# CONFIG_DEBUG_VM is not set
# CONFIG_DEBUG_VM_IRQSOFF is not set

# Boot-time page table self-test, useless afterwards.
# CONFIG_DEBUG_VM_PGTABLE is not set

# Hot paths here (PREEMPT_DYNAMIC + BORE).
# CONFIG_DEBUG_PREEMPT is not set

# A trade: this is also cheap hardening against list corruption.
# CONFIG_DEBUG_LIST is not set

# Kernel default. ALARM's 1024 trips on arm-smmu-v3's 1024-byte cmdq batch, which is by design.
CONFIG_FRAME_WARN=2048
