# Debug instrumentation the base configs leave on, which a daily driver does not
# want. Every symbol here is inherited -- no fragment asks for any of them -- and
# each costs runtime rather than just image size, which is why they are worth
# closing on machines built for BORE and CachyOS.
#
# Shared, not per-product: nothing here is board-specific, and both products
# inherit the same instrumentation from their respective bases.

# VM_BUG_ON checks throughout memory management, paid on page operations. The
# IRQSOFF variant depends on DEBUG_VM and falls out with it; it is listed so the
# PKGBUILD's post-olddefconfig check accounts for it rather than being surprised.
# CONFIG_DEBUG_VM is not set
# CONFIG_DEBUG_VM_IRQSOFF is not set

# A boot-time page table validation suite -- the "Validating architecture page
# table helpers" line -- that does nothing for the rest of uptime.
# CONFIG_DEBUG_VM_PGTABLE is not set

# Preempt-count validation on scheduling paths, which are hot here: these are
# PREEMPT_DYNAMIC kernels running BORE.
# CONFIG_DEBUG_PREEMPT is not set

# list_head integrity checks on every list operation. Note this one is as much
# cheap hardening against list corruption as it is debugging, so it is a
# deliberate trade rather than a free win -- re-enable if that matters more than
# the cycles.
# CONFIG_DEBUG_LIST is not set
