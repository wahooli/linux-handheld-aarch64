# Both products. Not in common/: el2 does not merge it.

# ============== Proton / Wine ==============
# =m like CachyOS; /dev/ntsync has no autoload, so the PKGBUILD ships a modules-load.d drop-in.
CONFIG_NTSYNC=m

# ============== Per-game / per-cgroup CPU QoS ==============
# TASK_GROUP is the cgroup-v2 interface systemd, gamescope and scx actually use.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# ============== Things CachyOS enables and we did not ==============
# From diffing CachyOS's config: '# ... is not set' in ours means offered and declined.

# CRIU and QEMU post-copy live migration (el2 runs KVM).
CONFIG_USERFAULTFD=y

# FUNCTION_TRACER is the costly one (mcount sites) and what kprobe-on-function needs.
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_KPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y

# Compressed modules, as every distro kernel ships.
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y

# Without these systemd's IOWeight= and the io.latency/io.cost knobs do nothing.
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_BLK_CGROUP_IOLATENCY=y
CONFIG_BLK_CGROUP_IOPRIO=y
CONFIG_BLK_WBT=y

# Misc cgroup controller; overlayfs features podman and docker enable by default.
CONFIG_CGROUP_MISC=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_XINO_AUTO=y

# fscrypt (systemd-homed); already on in ALARM.
CONFIG_FS_ENCRYPTION=y

# Cheap hardening the distros all ship.
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y

# fq_codel: systemd sets it as default_qdisc at boot. CAKE for Wi-Fi.
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=m
CONFIG_NET_SCH_NETEM=m
CONFIG_NET_SCH_HTB=m
