# Userland-facing features BOTH products want.
#
# config/common/ cannot hold these: el2 does not merge it, because it starts from
# a distro config and common/ exists to lift defconfig up to one.
#
# Keep this small. A symbol belongs here only if both products want it and it is
# neither hardware (product dirs) nor CachyOS tuning (config/cachy/).

# ============== Proton / Wine ==============
# NT synchronisation primitives, which Proton uses in place of the esync/fsync
# eventfd hacks. Off in the arm64 defconfig and in ALARM's.
#
# =m, matching CachyOS. The catch: /dev/ntsync is a misc device with no autoload
# path, and Proton checks for the node at startup and silently falls back to
# eventfd. So the PKGBUILD ships a modules-load.d drop-in -- keyed off this being
# modular, so flipping to =y removes it rather than leaving a stale loader.
CONFIG_NTSYNC=m

# ============== Per-game / per-cgroup CPU QoS ==============
# systemd, power-profiles-daemon, gamescope and the scx schedulers all set
# uclamp.min/max per cgroup. TASK_GROUP is the cgroup-v2 interface -- without it
# the knobs exist but not per-cgroup, which is the only form anything uses.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# ============== Things CachyOS enables and we did not ==============
# From diffing CachyOS's own published config against both products. A symbol
# absent from our .config is not offered on arm64; "# … is not set" means offered
# and declined -- only the second kind is a real gap.

# Userfaultfd. CRIU needs it, and so does QEMU/KVM POST-COPY live migration --
# which matters on el2 specifically, since that machine exists to run KVM.
CONFIG_USERFAULTFD=y

# Tracing. Off in both products, meaning no /sys/kernel/tracing at all.
# FUNCTION_TRACER is the one with a real cost (mcount call sites), and also what
# makes dynamic ftrace and kprobe-on-function work.
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_KPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y

# Compressed modules, as every distro kernel ships.
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y

# Without these, systemd's IOWeight=, IOReadBandwidthMax= and the io.latency /
# io.cost cgroup knobs exist in the unit files and do nothing.
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_BLK_CGROUP_IOLATENCY=y
CONFIG_BLK_CGROUP_IOPRIO=y
CONFIG_BLK_WBT=y

# Container plumbing: the misc controller, and the overlayfs features podman and
# docker turn on by default.
CONFIG_CGROUP_MISC=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_XINO_AUTO=y

# fscrypt, for ext4/f2fs native encryption (systemd-homed uses it). Already on in
# ALARM's config, so this only changes handheld.
CONFIG_FS_ENCRYPTION=y

# Cheap hardening the distros all ship.
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y

# Queueing disciplines. fq_codel is what systemd tries to set as
# net.core.default_qdisc at every boot; CAKE is the one worth having on wifi.
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=m
CONFIG_NET_SCH_NETEM=m
CONFIG_NET_SCH_HTB=m
