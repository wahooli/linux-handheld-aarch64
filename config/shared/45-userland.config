# Userland-facing features BOTH products want.
#
# This directory exists because these were duplicated and drifted: handheld had
# NTSYNC=m in its own fragment, el2 had it nowhere at all, and the result was a
# booted el2 kernel with no /dev/ntsync. config/common/ could not hold them --
# el2 deliberately does not merge that, because it starts from a distro config
# rather than defconfig and common/ exists to lift defconfig up to one.
#
# Keep this small. A symbol belongs here only if both products want it and it is
# neither hardware (product dirs) nor CachyOS tuning (config/cachy/).

# ============== Proton / Wine ==============
# NT synchronisation primitives in the kernel, which Proton uses in place of the
# esync/fsync eventfd hacks. Off in the arm64 defconfig and off in ALARM's.
#
# =y rather than =m, deliberately: /dev/ntsync is a misc device with no autoload
# path, so as a module the node does not exist until something modprobes it --
# and Proton decides at startup by checking whether the node is there. A module
# means it silently falls back to eventfd. This is what el2 hit.
CONFIG_NTSYNC=y

# ============== Per-game / per-cgroup CPU QoS ==============
# uclamp is how userspace tells the scheduler what to care about: systemd,
# power-profiles-daemon, gamescope and the scx schedulers all set uclamp.min/max
# per cgroup. TASK_GROUP is the cgroup-v2 interface -- without it the knobs exist
# but are not per-cgroup, which is the only form anything actually uses.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# ============== Things CachyOS enables and we did not ==============
# Found by diffing CachyOS's own published config (linux-cachyos/config, x86_64)
# against both products. The discriminator: a symbol ABSENT from our .config is
# not offered on arm64, while "# … is not set" means offered and we declined.
# Only the second kind is a real gap, and only the behavioural ones are here --
# the other ~3400 differences are a distro shipping every device driver.

# Userfaultfd. CRIU needs it, and so does QEMU/KVM POST-COPY live migration --
# which matters on el2 specifically, since that machine exists to run KVM.
CONFIG_USERFAULTFD=y

# Tracing. Off in both products, which means no /sys/kernel/tracing at all: no
# perf probe, no bpftrace kprobes, no function tracer. On a machine being
# bisected that is the wrong tool to be missing. FUNCTION_TRACER is the one with
# a real cost (mcount call sites); it is also what makes dynamic ftrace and
# kprobe-on-function work, which is the point.
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_KPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y

# Compressed modules, as every distro kernel ships. Our packages install .ko
# uncompressed today; kmod has handled .ko.zst for years.
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y

# I/O control. Without these, systemd's IOWeight=, IOReadBandwidthMax= and the
# io.latency/io.cost cgroup knobs exist in the unit files and do nothing.
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_BLK_CGROUP_IOLATENCY=y
CONFIG_BLK_CGROUP_IOPRIO=y
CONFIG_BLK_WBT=y

# Container plumbing: the misc controller, and the overlayfs features podman and
# docker turn on by default.
CONFIG_CGROUP_MISC=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_XINO_AUTO=y

# fscrypt, for ext4/f2fs native encryption (systemd-homed uses it). Already on in
# ALARM's config, so this only changes handheld.
CONFIG_FS_ENCRYPTION=y

# Cheap hardening the distros all ship.
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y

# Queueing disciplines. handheld had NONE of these -- not even fq_codel, which
# systemd tries to set as net.core.default_qdisc at every boot. CAKE is the one
# worth having on a laptop or a handheld on wifi; netem is for testing.
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=m
CONFIG_NET_SCH_NETEM=m
CONFIG_NET_SCH_HTB=m
