# Datacentre storage and networking, none of which can attach to a handheld, an
# ARM laptop, or the cheap SBCs these kernels may grow to cover. These are PCIe
# HBAs, RAID controllers and server NICs -- not the sort of thing that turns up
# on a USB-C dock.
#
# Unlike a trim by SoC vendor, this stays correct as more boards are added:
# nothing in that direction acquires a Fibre Channel HBA.

# SAS/RAID host bus adapters, and the transport attribute layers only they use.
# CONFIG_SCSI_HPSA is not set
# CONFIG_SCSI_MVSAS is not set
# CONFIG_SCSI_ARCMSR is not set
# CONFIG_SCSI_ESAS2R is not set
# CONFIG_SCSI_MPT3SAS is not set
# CONFIG_SCSI_SNIC is not set
# CONFIG_SCSI_IPR is not set
# CONFIG_MEGARAID_NEWGEN is not set
# CONFIG_MEGARAID_SAS is not set

# Fibre Channel and FCoE, plus the iSCSI/FC offload HBAs.
# CONFIG_SCSI_FC_ATTRS is not set
# CONFIG_FCOE is not set
# CONFIG_SCSI_QLA_FC is not set
# CONFIG_SCSI_QLA_ISCSI is not set
# CONFIG_BE2ISCSI is not set

# InfiniBand SRP attributes, orphaned once the above go.
# CONFIG_SCSI_SRP_ATTRS is not set

# Server NICs: Mellanox ConnectX, Broadcom NetXtreme II, Netronome, Pensando.
# CONFIG_NET_VENDOR_MELLANOX is not set
# CONFIG_NET_VENDOR_NETRONOME is not set
# CONFIG_NET_VENDOR_PENSANDO is not set
# CONFIG_BNX2 is not set
# CONFIG_BNX2X is not set

# The bnx2 iSCSI/FCoE offload stack has to go with them: CNIC does `select BNX2`,
# and the two storage drivers pull in CNIC, so leaving these would quietly drag
# BNX2 back in regardless of the line above.
# CONFIG_SCSI_BNX2_ISCSI is not set
# CONFIG_SCSI_BNX2X_FCOE is not set
# CONFIG_CNIC is not set
