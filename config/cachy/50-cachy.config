# CachyOS tuning that is NOT in their release tarball.
#
# The tarball carries their code; the "CachyOS feel" is their PKGBUILD's
# scripts/config calls, and none of those travel with it. This is the
# arch-neutral subset, with their own defaults (_HZ_ticks=1000, _preempt=full,
# _cc_harder=yes).
#
# Deliberately NOT taken, with reasons:
#
#   NO_HZ_FULL            their _tickrate=full. Does nothing without nohz_full=
#                         on the cmdline and costs overhead otherwise; NO_HZ_IDLE
#                         is asserted below instead.
#   TRANSPARENT_HUGEPAGE  their -e ..._ALWAYS IS a real change: the upstream
#                         default is MADVISE, which is what handheld ends up with.
#                         Declined on purpose -- ALWAYS raises the memory
#                         footprint, which matters most on the device with the
#                         least RAM. el2 has THP off entirely, from its base.
#                         Revisit per device; do not freeze it here.
#   LTO_CLANG_*, CFI_CLANG, AUTOFDO_CLANG, PROPELLER_CLANG, MZEN4,
#   X86_NATIVE_CPU        clang-only or x86-only; we build with gcc on arm64.

# Their own tweaks, gated behind one symbol. `default y` in init/Kconfig, so this
# is an assertion rather than a change -- which is the point: the build fails if a
# base ever stops providing it.
CONFIG_CACHY=y

# POC (Piece-Of-Cake) fast idle CPU selector, CachyOS's own. Compiled into
# fair.c behind a static key and `default y` in init/Kconfig, so this is another
# assertion. Runtime toggles live under sysctl kernel.sched_poc_*, starting with
# kernel.sched_poc_selector -- so it can be turned off on a booted kernel
# without a rebuild.
CONFIG_SCHED_POC_SELECTOR=y

# Per-session task groups. Already y in both bases; asserted because it is a
# large part of desktop responsiveness under load and easy to lose in a base bump.
CONFIG_SCHED_AUTOGROUP=y

# 1000 Hz. arm64's Kconfig default is 250; the running el2 kernel is already
# 1000, so this is a change for handheld and a no-op for el2.
CONFIG_HZ_1000=y
CONFIG_HZ=1000
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set

# Scheduler-controlled preemption. A real change for both products, which are
# CONFIG_PREEMPT=y today. Note PREEMPT_DYNAMIC is also on, so the model stays
# switchable at boot with preempt=none|voluntary|full -- this sets the default.
CONFIG_PREEMPT_LAZY=y
# CONFIG_PREEMPT is not set

# Tick off when idle. Already true in both bases; asserted so a base bump cannot
# quietly turn it into NO_HZ_FULL or HZ_PERIODIC on a battery device.
CONFIG_NO_HZ_IDLE=y
# CONFIG_NO_HZ_FULL is not set

# -O3 (their _cc_harder=yes). Bigger image, marginally faster code.
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set

# Hugepages for shmem and tmpfs, on madvise only. The README's "Transparent
# Hugepages: ADVISE mode for shmem/tmpfs"; both bases leave these at NEVER.
# ADVISE rather than ALWAYS for the same reason as the main THP mode: it only
# applies where userspace asked, so it cannot inflate every mapping.
CONFIG_TRANSPARENT_HUGEPAGE_SHMEM_HUGE_ADVISE=y
CONFIG_TRANSPARENT_HUGEPAGE_TMPFS_HUGE_ADVISE=y

# Runtime-selectable preemption model (preempt=none|voluntary|full on the
# cmdline). Already y in both bases -- asserted because PREEMPT_LAZY above is
# only the DEFAULT, and this is what makes it changeable without a rebuild.
CONFIG_PREEMPT_DYNAMIC=y

# ADIOS, CachyOS's own multi-queue I/O scheduler, plus the ones upstream ships.
# =m: it is selected per device at runtime
# (echo adios > /sys/block/<dev>/queue/scheduler), not at boot.
CONFIG_MQ_IOSCHED_ADIOS=m
CONFIG_IOSCHED_BFQ=y
CONFIG_MQ_IOSCHED_DEADLINE=y

# BBR3 as the default congestion control, with fq as the default qdisc.
#
# Note what CachyOS's own _tcp_bbr3=yes switch does, because it is not this: it
# enables TCP_CONG_BBR and DEFAULT_BBR, i.e. upstream BBR *v1*. Their tree has
# both as separate tristates -- tcp_bbr.o and tcp_bbr3.o -- and only the second
# registers as "bbr3". So this enables BBR3 proper.
#
# =y, not =m: DEFAULT_BBR3 is only offered when TCP_CONG_BBR3 is built in
# (net/ipv4/Kconfig: bool "BBR3" if TCP_CONG_BBR3=y).
#
# TCP_CONG_ADVANCED first: everything past upstream's cubic/reno lives inside
# `if TCP_CONG_ADVANCED` (net/ipv4/Kconfig:478), so without it the BBR3 symbol is
# not offered at all and every line below is silently dropped. arm64 defconfig
# does not set it; ALARM's config does.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR3=y
CONFIG_DEFAULT_BBR3=y
CONFIG_DEFAULT_TCP_CONG="bbr3"
# CONFIG_DEFAULT_CUBIC is not set

# BBR needs fq pacing to behave; with fq_codel it underperforms and can starve.
# CachyOS switches the default qdisc for the same reason. cubic stays built in
# (they demote it to a module; that only saves size) so falling back is a
# sysctl away: net.ipv4.tcp_congestion_control=cubic.
CONFIG_NET_SCH_FQ=y
# Same shape as TCP_CONG_ADVANCED: the DEFAULT_NET_SCH choice sits inside
# `if NET_SCH_DEFAULT` (net/sched/Kconfig:440), so the override has to be
# enabled before a default can be picked.
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
CONFIG_DEFAULT_NET_SCH="fq"
# CONFIG_DEFAULT_FQ_CODEL is not set
