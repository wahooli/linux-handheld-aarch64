# CachyOS's PKGBUILD tuning, which their tarball does not carry; the arch-neutral subset.
# Declined: NO_HZ_FULL, THP ALWAYS, clang- and x86-only options.

# default y upstream: an assertion that the base still provides it.
CONFIG_CACHY=y

# CachyOS's fast idle-CPU selector, default y; toggle with sysctl kernel.sched_poc_selector.
CONFIG_SCHED_POC_SELECTOR=y

# Already y in both bases; asserted because a bump can lose it.
CONFIG_SCHED_AUTOGROUP=y

# arm64 defaults to 250; the el2 base was already 1000.
CONFIG_HZ_1000=y
CONFIG_HZ=1000
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set

# Only the default; PREEMPT_DYNAMIC keeps it switchable at boot.
CONFIG_PREEMPT_LAZY=y
# CONFIG_PREEMPT is not set

# Asserted so a bump cannot switch a battery device to NO_HZ_FULL or periodic.
CONFIG_NO_HZ_IDLE=y
# CONFIG_NO_HZ_FULL is not set

# -O3 (their _cc_harder=yes). Bigger image, marginally faster code.
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set

# Only where userspace asks, so it cannot inflate every mapping.
CONFIG_TRANSPARENT_HUGEPAGE_SHMEM_HUGE_ADVISE=y
CONFIG_TRANSPARENT_HUGEPAGE_TMPFS_HUGE_ADVISE=y

CONFIG_PREEMPT_DYNAMIC=y

# =m: selected per device at runtime via /sys/block/<dev>/queue/scheduler.
CONFIG_MQ_IOSCHED_ADIOS=m
CONFIG_IOSCHED_BFQ=y
CONFIG_MQ_IOSCHED_DEADLINE=y

CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR3=y
CONFIG_DEFAULT_BBR3=y
CONFIG_DEFAULT_TCP_CONG="bbr3"
# CONFIG_DEFAULT_CUBIC is not set

# BBR wants fq pacing; cubic stays built in.
CONFIG_NET_SCH_FQ=y
# The DEFAULT_NET_SCH choice sits inside `if NET_SCH_DEFAULT`.
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
CONFIG_DEFAULT_NET_SCH="fq"
# CONFIG_DEFAULT_FQ_CODEL is not set
