# CachyOS tuning that is NOT in their release tarball.
#
# The tarball carries their code; the "CachyOS feel" is their PKGBUILD's
# scripts/config calls, which do not travel with it. This is the arch-neutral
# subset, with their own defaults.
#
# Deliberately not taken:
#
#   NO_HZ_FULL            does nothing without nohz_full= on the cmdline and
#                         costs overhead otherwise; NO_HZ_IDLE below instead
#   TRANSPARENT_HUGEPAGE  their _ALWAYS raises the memory footprint, which
#                         matters most on the device with the least RAM. Revisit
#                         per device rather than freezing it here.
#   LTO_CLANG_*, CFI_CLANG, AUTOFDO_CLANG, PROPELLER_CLANG, MZEN4,
#   X86_NATIVE_CPU        clang-only or x86-only; we build with gcc on arm64

# Their own tweaks, gated behind one symbol. `default y` in init/Kconfig, so this
# is an assertion: the build fails if a base ever stops providing it.
CONFIG_CACHY=y

# POC (Piece-Of-Cake) fast idle CPU selector, CachyOS's own. Another assertion --
# `default y` in init/Kconfig, behind a static key in fair.c. Toggle at runtime
# with sysctl kernel.sched_poc_selector.
CONFIG_SCHED_POC_SELECTOR=y

# Per-session task groups. Already y in both bases; asserted because it is easy
# to lose in a base bump and a large part of responsiveness under load.
CONFIG_SCHED_AUTOGROUP=y

# 1000 Hz. arm64's Kconfig default is 250; the running el2 kernel is already
# 1000, so this is a change for handheld and a no-op for el2.
CONFIG_HZ_1000=y
CONFIG_HZ=1000
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set

# Scheduler-controlled preemption, a real change for both products. Only the
# default: PREEMPT_DYNAMIC below keeps it switchable at boot.
CONFIG_PREEMPT_LAZY=y
# CONFIG_PREEMPT is not set

# Tick off when idle. Asserted so a base bump cannot quietly turn it into
# NO_HZ_FULL or HZ_PERIODIC on a battery device.
CONFIG_NO_HZ_IDLE=y
# CONFIG_NO_HZ_FULL is not set

# -O3 (their _cc_harder=yes). Bigger image, marginally faster code.
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set

# Hugepages for shmem and tmpfs; both bases leave these at NEVER. ADVISE rather
# than ALWAYS for the same reason as the main THP mode -- it only applies where
# userspace asked, so it cannot inflate every mapping.
CONFIG_TRANSPARENT_HUGEPAGE_SHMEM_HUGE_ADVISE=y
CONFIG_TRANSPARENT_HUGEPAGE_TMPFS_HUGE_ADVISE=y

# Runtime-selectable preemption model (preempt=none|voluntary|full). Asserted
# because it is what makes PREEMPT_LAZY above changeable without a rebuild.
CONFIG_PREEMPT_DYNAMIC=y

# ADIOS, CachyOS's own multi-queue I/O scheduler, plus the ones upstream ships.
# =m: it is selected per device at runtime
# (echo adios > /sys/block/<dev>/queue/scheduler), not at boot.
CONFIG_MQ_IOSCHED_ADIOS=m
CONFIG_IOSCHED_BFQ=y
CONFIG_MQ_IOSCHED_DEADLINE=y

CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR3=y
CONFIG_DEFAULT_BBR3=y
CONFIG_DEFAULT_TCP_CONG="bbr3"
# CONFIG_DEFAULT_CUBIC is not set

# BBR needs fq pacing to behave; with fq_codel it underperforms and can starve.
# cubic stays built in, so falling back is one sysctl away.
CONFIG_NET_SCH_FQ=y
# Same shape as TCP_CONG_ADVANCED: the DEFAULT_NET_SCH choice sits inside
# `if NET_SCH_DEFAULT`, so the override comes before the default.
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
CONFIG_DEFAULT_NET_SCH="fq"
# CONFIG_DEFAULT_FQ_CODEL is not set
