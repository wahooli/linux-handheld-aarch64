# Handheld and gaming behaviour that is architecture-independent.

# ============== Memory pressure ==============
# MGLRU: a large win on reclaim behaviour with fixed, non-expandable RAM running
# a compositor, a game and an Android runtime at once. LRU_GEN alone only builds
# it; LRU_GEN_ENABLED turns it on without a boot parameter.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# ============== Firmware loading ==============
# linux-firmware ships xz- and zstd-compressed blobs now. Without these the
# loader does not find firmware that is present on disk, and the symptom is
# identical to the firmware being absent.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# ============== Removable media ==============
# SD cards arrive formatted by Windows, a camera or another console. exFAT and
# NTFS3 were already on; these are what makes them usable.
#
# UNICODE provides the case-folding tables exFAT and ext4 casefold need. The NLS
# codepages are what FAT mounts use for non-ASCII filenames -- without a matching
# one the mount succeeds and the filenames are mojibake.
CONFIG_UNICODE=y
CONFIG_MSDOS_FS=m
CONFIG_NLS_CODEPAGE_850=m
CONFIG_NLS_ISO8859_15=m
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_HID_RAZER=m
