# ============== Memory pressure ==============
# MGLRU: fixed RAM running a compositor, a game and an Android runtime; _ENABLED needs no boot param.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# ============== Firmware loading ==============
# Without these, compressed firmware on disk looks exactly like missing firmware.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# ============== Removable media ==============
# SD cards formatted elsewhere: casefold tables, and FAT codepages (else mojibake filenames).
CONFIG_UNICODE=y
CONFIG_MSDOS_FS=m
CONFIG_NLS_CODEPAGE_850=m
CONFIG_NLS_ISO8859_15=m
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_HID_RAZER=m
