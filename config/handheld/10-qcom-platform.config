# Odin 3 / SM8750 hardware, from armada's kernel/config/armada-kernel.config.overrides.

# ============== DRM / display ==============
# Built in: as a module DRM_MSM misses the bootloader's panel handoff (black screen). Its deps too.
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_SCHED=y
CONFIG_DRM_GPUVM=y
CONFIG_DRM_EXEC=y
CONFIG_DRM_DISPLAY_DP_HELPER=y
CONFIG_DRM_DISPLAY_DP_AUX_BUS=y
CONFIG_DRM_DISPLAY_DSC_HELPER=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_BRIDGE_CONNECTOR=y
CONFIG_DRM_PANEL_BRIDGE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y

# ============== the Odin 3 panel ==============
# The panel (chipone,icna3520), =y like DRM_MSM; BACKLIGHT_CLASS_DEVICE=m would silently cap it at =m.
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_CHIPONE_ICNA35XX=y

# ============== Qualcomm platform ==============
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_UBWC_CONFIG=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_PBS=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_FASTRPC=y
CONFIG_IOMMU_IO_PGTABLE=y
CONFIG_TRACE_GPU_MEM=y

# ============== Clocks / PHY (SM8750) ==============
# A menuconfig at =m caps its children at =m, so the parent is forced first.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_EDP=y

# ============== IPC / remoteproc plumbing ==============
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_PDR_MSG=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_APR=y
CONFIG_MHI_BUS=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QRTR_TUN=y
CONFIG_QRTR_MHI=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_CTRL=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
# TYPEC=m would cap QCOM_PMIC_GLINK at =m.
CONFIG_TYPEC=y
CONFIG_QCOM_PMIC_GLINK=y
# Off: needs EVENT_TRACING (FTRACE + ENABLE_DEFAULT_TRACERS); it only logs ADSP charger firmware.
# CONFIG_QCOM_PMIC_PDCHARGER_ULOG=m

# ============== WCN7860 Wi-Fi + Bluetooth ==============
# Pinned though defconfig enables it, so the verification guards what armada's WCN7860 patches need.
# =m: nothing here is needed before the rootfs mounts.

# BT_QCA loads the WCN7860 blobs; no prompt (selected by BT_HCIUART_QCA), pinned as a guard.
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_QCA=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
# BT_HCIUART_SERDEV depends on this, and the defconfig builds it in.
CONFIG_SERIAL_DEV_BUS=y

# PCI support is part of ATH12K; there is no ATH12K_PCI.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_ATH12K=m

# The WCN7860's Wi-Fi and BT halves share a PMU and need power sequencing.
CONFIG_POWER_SEQUENCING_QCOM_WCN=m
CONFIG_PCI_PWRCTRL_PWRSEQ=m

# ============== Boot storage: UFS ==============
# Built in: the Odin 3 has no initramfs, so a module means no root device.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y

# ============== Clock controllers behind DRM_MSM ==============
# =y: DRM_MSM is built in, so its clocks must be too.
CONFIG_SM_DISPCC_8750=y
CONFIG_SM_GPUCC_8750=y
CONFIG_SM_TCSRCC_8750=y

# ============== Odin 3 peripherals its DTS actually names ==============
# Named by the Odin 3 DTS: without them the build is green and gamepad/rumble/speakers/RGB are dead.
CONFIG_JOYSTICK_RSINPUT=m
CONFIG_INPUT_QCOM_HV_HAPTICS=m
CONFIG_SND_SOC_AW88166=m
CONFIG_LEDS_HTR3212=m
# LEDS_HTR3212 depends on LEDS_CLASS && I2C and selects REGMAP_I2C.
CONFIG_LEDS_CLASS=y
CONFIG_I2C=y

# ADSP Modern Standby notifier (shared patch 0247); binds only if the ADSP announces the channel.
CONFIG_QCOM_ADSP_PWR_LMTS=m
