# Game controller drivers.
#
# Found by diffing this kernel against ALARM's stock linux-aarch64: the generic
# input stack was all present and correct —
#
#   HIDRAW=y  UHID=y  INPUT_EVDEV=y  INPUT_UINPUT=y  INPUT_JOYDEV=m
#   HID_MULTITOUCH=m  INPUT_FF_MEMLESS=m  BT=m  BT_HIDP=m
#
# — while EVERY vendor gamepad driver was missing. On a gaming handheld that is a
# worse gap than it looks in a config diff: the arm64 defconfig simply has no
# reason to enable them, and nothing in this repo had noticed.
#
# What partially masks it, and why it might not look broken at first: Steam talks
# to most modern controllers over hidraw directly, which works without any of
# these. What you lose without the kernel drivers is the evdev/joydev node,
# rumble, battery reporting, LED control, and correct identification in Steam
# Input — so a pad half-works, which is harder to diagnose than one that does not
# work at all.
#
# The Odin 3's own built-in controls do NOT depend on this file; they come from the
# RSInput patch in the stack. This is for everything plugged in or paired.
#
# Modules rather than built-in: none of it is needed to boot, and udev loads them
# on device probe. Matches stock ALARM. Every symbol here was checked against
# drivers/hid/Kconfig and drivers/input/joystick/Kconfig in the 7.2 tree — note
# there is deliberately no MICROSOFT_FF, because no such symbol exists.

# THE GATE. drivers/input/joystick/Kconfig opens with `menuconfig INPUT_JOYSTICK`,
# so every joystick driver below is unreachable without it — and the arm64
# defconfig leaves it off. CONFIG_JOYSTICK_XPAD had been requested in
# 20-arch-userland.config since the beginning and silently never applied for
# exactly this reason; the PKGBUILD only verified =y lines, so a dropped =m was
# invisible. Both halves are fixed now.
#
# Note INPUT_JOYSTICK is distinct from INPUT_JOYDEV (=m, already on): JOYDEV is
# the /dev/input/jsN interface, INPUT_JOYSTICK is the driver menu.
CONFIG_INPUT_JOYSTICK=y

# Battery level for wireless pads, which the Steam UI displays. =y because it is
# a HID core option, not a driver.
CONFIG_HID_BATTERY_STRENGTH=y

# --- PlayStation ---------------------------------------------------------------
# hid-playstation is the modern driver: DualSense, DualSense Edge, DualShock 4.
# hid-sony covers the older DualShock 3 and Sixaxis, which are still common.
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_SONY=m
CONFIG_SONY_FF=y

# --- Xbox ----------------------------------------------------------------------
# Two separate drivers and both are needed: xpad handles the USB/wireless-dongle
# protocol (Xbox 360, One, Series over cable), hid-microsoft handles the Bluetooth
# HID mode the newer pads use.
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_HID_MICROSOFT=m

# --- Nintendo ------------------------------------------------------------------
# Switch Pro Controller and Joy-Cons, over USB or Bluetooth.
CONFIG_HID_NINTENDO=m
CONFIG_NINTENDO_FF=y

# --- Valve ---------------------------------------------------------------------
# Steam Controller, and the Steam Deck's own control interface. Worth having on a
# handheld running the Deck UI even though this is not a Deck: it is what a
# plugged-in Steam Controller needs.
CONFIG_HID_STEAM=m
CONFIG_STEAM_FF=y

# --- Logitech ------------------------------------------------------------------
# Gamepads, wheels, and the Unifying receiver — HIDPP is what makes battery and
# per-device features work through a single dongle.
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m
CONFIG_LOGITECH_FF=y
CONFIG_LOGIRUMBLEPAD2_FF=y
CONFIG_LOGIG940_FF=y
CONFIG_LOGIWHEELS_FF=y

# --- assorted third-party pads -------------------------------------------------
# Cheap to carry and each covers a family of generic pads that would otherwise
# fall back to a bare HID descriptor with no rumble.
CONFIG_HID_BETOP_FF=m
CONFIG_HID_GOOGLE_STADIA_FF=m
CONFIG_HID_MAYFLASH=m

# Apple keyboards/trackpads — not a controller, but the same class of "plug in a
# common peripheral and it should work" and it is one module.
CONFIG_HID_APPLE=m
