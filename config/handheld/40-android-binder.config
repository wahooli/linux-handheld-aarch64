# Android binder — required by Lepton (Steam's Android runtime, app 3029110),
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""

# Waydroid/Lepton's guest init reads /proc/pressure/* and refuses to come up
# without it. PSI_DEFAULT_DISABLED stays n, so it is live without psi=1.
CONFIG_PSI=y
CONFIG_NF_CT_NETLINK=m
