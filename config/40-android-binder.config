# Android binder — required by Lepton (Steam's Android runtime, app 3029110),
# which boots a LineageOS guest in a rootless podman container and needs the
# binder IPC driver on the HOST kernel (the guest's /dev/*binder devices are
# binderfs devices passed through by the container runtime).
#
# binderfs creates the initial device nodes from the kernel cmdline:
# `binder.devices=anbox-binder,anbox-hwbinder,anbox-vndbinder` — see
# profiles/ayn-odin3/bootimg-args. Built-in (=y) because there is no initramfs
# and Lepton expects the devices to exist before any module loading logic runs.
#
# This is the exact setup verified working on the Yoga Slim 7x (X1E) host —
# see docs/lepton-android.md.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""

# Pressure-stall information — Waydroid/Lepton's guest init reads
# /proc/pressure/* and refuses to come up without it. No deps; PSI_DEFAULT_DISABLED
# stays n, so it is live without a psi=1 cmdline.
CONFIG_PSI=y

# Conntrack netlink, for the container's NAT'd networking. =m rather than =y
# because CONFIG_NF_CONNTRACK is =m here — a =y request would be demoted by
# olddefconfig and then fail the PKGBUILD's fragment check.
CONFIG_NF_CT_NETLINK=m
