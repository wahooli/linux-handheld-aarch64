# BORE -- Burst-Oriented Response Enhancer, CachyOS's interactivity scheduler.
#
# Requires CACHY_SCHED=bore in the product conf, which is what fetches and
# applies sched/0001-bore-cachy.patch. Without the patch this symbol does not
# exist, olddefconfig drops it, and the PKGBUILD's verifier fails the build --
# which is the intended coupling: config and patch travel together or not at all.
#
# BORE also adds MIN_BASE_SLICE_NS (default 2000000) to kernel/Kconfig.hz. Left
# at its default, which is what CachyOS ships.
CONFIG_SCHED_BORE=y
