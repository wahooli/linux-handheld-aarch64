# What a systemd/Arch userland needs on top of arm64 defconfig.

# ============== systemd / udev hard requirements ==============
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_NET=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_FHANDLE=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ============== namespaces — containers, flatpak, bwrap, Steam ==============
# Steam's pressure-vessel runtime and every flatpak use user namespaces.
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y

# ============== filesystems Arch actually uses ==============
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_F2FS_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EROFS_FS=y

# ============== loadable modules ==============
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ============== gaming / Proton / Wine ==============
# fsync/futex_waitv is what modern Proton uses for thread synchronisation.
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y
# Anonymous shared memory used by Wine and various anti-cheat-free titles.
CONFIG_MEMFD_CREATE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# 4K pinned: emulator builds on ARM assume 4K pages, and a 16K kernel would break them silently.
CONFIG_ARM64_4K_PAGES=y
# sched_ext: needs BPF + DEBUG_INFO_BTF (pahole at build time); defconfig's DEBUG_INFO_REDUCED
# silently disables BTF and SCHED_CLASS_EXT with it.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y

# ============== networking for NetworkManager + Steam ==============
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_TABLES=m
CONFIG_NETFILTER_XTABLES=m
CONFIG_BRIDGE=m
CONFIG_TUN=m
CONFIG_VETH=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m

# ============== misc userland expectations ==============
CONFIG_UNIX=y
CONFIG_UNIX_DIAG=m
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_JOYDEV=m
CONFIG_INPUT_EVDEV=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_USB_HIDDEV=y
# JOYSTICK_XPAD lives in 25-controllers, next to its INPUT_JOYSTICK gate.
CONFIG_SND_HDA_PREALLOC_SIZE=2048
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS=y
CONFIG_SYNC_FILE=y

# ============== pacman 7 sandbox ==============
# Selects SECURITY_NETWORK/PATH itself; landlock is already in the default LSM string.
CONFIG_SECURITY_LANDLOCK=y
# systemd-sysctl ships kernel.yama.ptrace_scope expecting yama.
CONFIG_SECURITY_YAMA=y

# ============== AppImages and disc images ==============
# AppImages: XATTR keeps bundled executables' capabilities; some builds use LZ4/LZO.
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
# Emulator disc images (CD, DVD); nothing mounts them at boot.
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m

# systemd-binfmt expects it; prerequisite for x86-64 binaries outside Steam.
CONFIG_BINFMT_MISC=y
