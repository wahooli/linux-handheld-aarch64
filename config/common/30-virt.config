# The arm64 defconfig already gives VIRTIO, VIRTIO_PCI, VIRTIO_BLK, VIRTIO_NET,
# VIRTIO_CONSOLE, HW_RANDOM_VIRTIO, PCI_HOST_GENERIC and SERIAL_AMBA_PL011, so
# the kernel already reaches a serial console. These three are what it lacks:
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_VIRTIO_INPUT=y
CONFIG_SND_VIRTIO=m

