# Light-workstation use: VM host, containers, encrypted volumes, network shares.
#
# The handheld is intended to double as a small workstation from the desktop
# session, and the arm64 defconfig is aimed at neither containers nor a KVM host.
# Everything here was picked by diffing against ALARM's stock linux-aarch64, which
# is a general-purpose distro kernel and therefore a good baseline for "what does
# a normal Arch userland expect to exist".
#
# ── KVM: already enabled, and probably still unusable on the Odin 3 ────────────
# CONFIG_KVM=y and CONFIG_VIRTUALIZATION=y come from the arm64 defconfig, so there
# was nothing to turn on. What was missing is the host-side plumbing below.
#
# Read this before planning around it: on arm64, KVM requires the kernel to be
# entered at EL2. Qualcomm Android platforms normally keep EL2 for their own
# hypervisor (Gunyah/QHEE), hand Linux EL1, and KVM then reports
#
#     kvm [1]: HYP mode not available
#
# with /dev/kvm absent. Whether the ROCKNIX ABL hands off at EL2 on the Odin 3 is
# UNVERIFIED. Check on the device with:
#
#     dmesg | grep -iE 'CPU:.*EL[12]|kvm|HYP'
#
# If it says EL1, no kernel option fixes it — it is a firmware/bootloader
# property, and QEMU falls back to TCG (usable, slow). Everything in this file is
# still worth having either way: the vhost/vsock bits also accelerate being a
# guest, and none of the rest depends on KVM.
#
# qemu-virt cannot answer this question either — nested virtualisation is not
# enabled on the host, so KVM inside the VM will be unavailable regardless.

# ── KVM host plumbing ─────────────────────────────────────────────────────────
# vhost moves virtio dataplanes into the kernel. Without VHOST_NET, guest
# networking falls back to userspace and costs a great deal of throughput.
CONFIG_VHOST=m
CONFIG_VHOST_IOTLB=m
CONFIG_VHOST_NET=m
CONFIG_VHOST_VSOCK=m
CONFIG_VHOST_TASK=y

# AF_VSOCK: how qemu-guest-agent, libvirt console access and virtiofsd talk to a
# guest without needing guest networking at all.
CONFIG_VSOCKETS=m
CONFIG_VSOCKETS_LOOPBACK=m
CONFIG_VSOCKETS_DIAG=m

# ── containers (docker / podman) ──────────────────────────────────────────────
# Most of the stack is already present from the defconfig — NETFILTER=y,
# NF_TABLES=m, NF_CONNTRACK=m, IP_NF_IPTABLES=m, BRIDGE=m, VETH=m, MACVLAN=m,
# OVERLAY_FS=y, USER_NS=y, all the cgroup controllers. These are the gaps.
#
# NF_NAT is the load-bearing one: without it there is no container NAT at all, so
# `docker run` gets a container with no outbound network and an error that points
# at iptables rather than at the kernel.
CONFIG_NF_NAT=m
CONFIG_NF_NAT_MASQUERADE=y
# Two nested gates, discovered one at a time because each hid the next:
#
#   NETFILTER_XTABLES_LEGACY  bool, off in the arm64 defconfig
#     └─ IP_NF_IPTABLES_LEGACY   depends on it (and on NETFILTER_XTABLES)
#          └─ IP_NF_NAT, IP_NF_FILTER, IP_NF_TARGET_MASQUERADE
#
# The tables depend on IP_NF_IPTABLES_LEGACY, NOT on IP_NF_IPTABLES (which was
# already =m and looked sufficient). Modern userspace mostly uses iptables-nft, so
# this is for compatibility with anything still calling iptables-legacy — stock
# ALARM enables it for the same reason.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_FILTER=m
CONFIG_BRIDGE_NETFILTER=m

# The xt matches docker's own check-config.sh looks for by name.
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m

# nftables equivalents, for podman and for docker's nft backend.
# NF_TABLES_IPV4 is the gate here: NFT_NAT depends on
# `NF_TABLES_IPV4 || NF_TABLES_IPV6`, and the defconfig sets neither.
CONFIG_NF_TABLES_IPV4=y
# (There is deliberately no CONFIG_NFT_CHAIN_NAT — that symbol does not exist in
# 7.2. It was in the first draft of this file and the PKGBUILD's =m check caught
# it, which is the whole reason that check now exists.)
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_COMPAT=m

# Per-cgroup network classification, which systemd and container runtimes use for
# accounting and traffic control.
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y

# ── memory: swap on a device with no swap partition ───────────────────────────
# The image ships a single ext4 root and no swap. zram is how a handheld gets
# usable swap without carving out storage — compressed swap in RAM. zswap covers
# the case where a real swap file is added later.
#
# zstd rather than the lzo-rle default, following armada: a materially better
# compression ratio at a cost this SoC does not notice, which on a device with
# fixed, non-expandable RAM converts directly into more resident game. lzo stays
# compiled so an existing zram device created with it still works.
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSWAP=y

# ── encrypted volumes ─────────────────────────────────────────────────────────
# dm-crypt for LUKS on an SD card or external drive; the crypto user API is what
# cryptsetup and systemd-cryptsetup actually call through.
CONFIG_DM_CRYPT=m
# =m, not =y: BLK_DEV_DM is itself a module, and a =y child of a =m parent is
# simply unsatisfiable — Kconfig drops it without comment.
CONFIG_DM_SNAPSHOT=m
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y
# systemd-creds, fscrypt and dm-crypt keyring support.
CONFIG_ENCRYPTED_KEYS=y

# ── network filesystems ───────────────────────────────────────────────────────
# NFS_FS is already =y from the defconfig. CIFS is not, and SMB is what a shared
# drive on a home network almost always is.
CONFIG_CIFS=m
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
CONFIG_CIFS_UPCALL=y
CONFIG_CIFS_DFS_UPCALL=y

# ── observability ─────────────────────────────────────────────────────────────
# kprobes underpins perf probe, bpftrace and most of the BPF tooling that makes a
# machine debuggable. BPF_SYSCALL/BPF_JIT/DEBUG_INFO_BTF are already on for
# sched_ext (see 20-arch-userland.config), so this completes that set rather than
# starting a new one — BTF without kprobes is half a tracing stack.
#
# Deliberately NOT enabling CONFIG_FTRACE: it is the heavier subsystem, stock
# ALARM leaves it off too, and the only thing in this repo that wanted it is the
# PDCharger ULOG driver noted in 10-qcom-platform.config.
CONFIG_KPROBES=y
CONFIG_CHECKPOINT_RESTORE=y

# ── USB peripherals a workstation plugs in ────────────────────────────────────
# USB_STORAGE, SND_USB_AUDIO, USB_ACM and USB_SERIAL are already present. These
# are the serial bridge chips — the ones that matter if this machine is ever used
# to talk to a microcontroller or a console cable, which is most of the point of
# a portable workstation.
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_PRINTER=m

# ============== Docker / podman gaps ==============
# Checked against docker's own check-config.sh: everything else it wants was
# already on. These four were not, and each is inherited-from-defconfig rather
# than a decision.
#
# NF_NAT_REDIRECT      published ports (-p) via REDIRECT
# NF_TABLES_IPV6       the nftables backend both docker and firewalld default to
# BLK_DEV_THROTTLING   --device-read-bps / --device-write-bps; blkio cgroup
#                      limits silently do nothing without it
# XFRM_USER            the xfrm netlink interface; it selects XFRM_ALGO, which
#                      has no prompt of its own and cannot be requested directly
CONFIG_NF_NAT_REDIRECT=m
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_INET=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_XFRM_USER=m

# ebtables. Docker's legacy bridge networking reaches for it, and it is the one
# piece of the container networking stack the arm64 defconfig leaves out.
# BRIDGE_NF_EBTABLES is the core; the filter and nat tables depend on the
# _LEGACY symbol instead, which is a separate opt-in since the nft rework.
CONFIG_BRIDGE_NF_EBTABLES=m
CONFIG_BRIDGE_NF_EBTABLES_LEGACY=m
CONFIG_BRIDGE_EBT_T_FILTER=m
CONFIG_BRIDGE_EBT_T_NAT=m

# nftables expression modules. NF_TABLES itself was on but these were not, so a
# nft ruleset using them fails to load at runtime rather than at install.
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NAT=m

# WireGuard. In-tree, cheap, and the obvious way to reach the device remotely.
CONFIG_WIREGUARD=m

# XFS. Absent entirely, while stock linux-aarch64 has it -- so an external disk
# or image formatted xfs would simply not mount on a kernel that claims to
# provide linux-aarch64.
CONFIG_XFS_FS=m
CONFIG_XFS_POSIX_ACL=y
