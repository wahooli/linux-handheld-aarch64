# Light-workstation use: VM host, containers, encrypted volumes, network shares.

# ── KVM host plumbing ─────────────────────────────────────────────────────────
# vhost moves virtio dataplanes into the kernel. Without VHOST_NET, guest
# networking falls back to userspace and loses a lot of throughput.
CONFIG_VHOST=m
CONFIG_VHOST_IOTLB=m
CONFIG_VHOST_NET=m
CONFIG_VHOST_VSOCK=m
CONFIG_VHOST_TASK=y

# AF_VSOCK: how qemu-guest-agent, libvirt console access and virtiofsd talk to a
# guest without needing guest networking at all.
CONFIG_VSOCKETS=m
CONFIG_VSOCKETS_LOOPBACK=m
CONFIG_VSOCKETS_DIAG=m

# ── containers (docker / podman) ──────────────────────────────────────────────
# Most of the stack comes from the defconfig; these are the gaps. NF_NAT is the
# load-bearing one -- without it there is no container NAT at all, and the error
# points at iptables rather than at the kernel.
CONFIG_NF_NAT=m
CONFIG_NF_NAT_MASQUERADE=y
# Two nested gates:
#
#   NETFILTER_XTABLES_LEGACY  bool, off in the arm64 defconfig
#     └─ IP_NF_IPTABLES_LEGACY   depends on it (and on NETFILTER_XTABLES)
#          └─ IP_NF_NAT, IP_NF_FILTER, IP_NF_TARGET_MASQUERADE
#
# The tables depend on IP_NF_IPTABLES_LEGACY, not on IP_NF_IPTABLES (already =m,
# which looks sufficient). For anything still calling iptables-legacy; stock
# ALARM enables it for the same reason.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_FILTER=m
CONFIG_BRIDGE_NETFILTER=m

# The xt matches docker's own check-config.sh looks for by name.
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m

# nftables equivalents, for podman and docker's nft backend. NF_TABLES_IPV4 is
# the gate: NFT_NAT depends on `NF_TABLES_IPV4 || NF_TABLES_IPV6`, and the
# defconfig sets neither.
CONFIG_NF_TABLES_IPV4=y
# (No CONFIG_NFT_CHAIN_NAT: that symbol does not exist in 7.2.)
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_COMPAT=m

# Per-cgroup network classification, which systemd and container runtimes use for
# accounting and traffic control.
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y

# ── memory: swap on a device with no swap partition ───────────────────────────
# The image ships a single ext4 root and no swap, so zram is how it gets usable
# swap without carving out storage. zswap covers a real swap file added later.
#
# zstd rather than the lzo-rle default, following armada: a better ratio at a cost
# this SoC does not notice. lzo stays compiled so an existing zram device created
# with it still works.
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSWAP=y

# ── encrypted volumes ─────────────────────────────────────────────────────────
# dm-crypt for LUKS on an SD card or external drive; the crypto user API is what
# cryptsetup and systemd-cryptsetup call through.
CONFIG_DM_CRYPT=m
# =m, not =y: BLK_DEV_DM is itself a module, and Kconfig drops a =y child of a =m
# parent without comment.
CONFIG_DM_SNAPSHOT=m
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y
# systemd-creds, fscrypt and dm-crypt keyring support.
CONFIG_ENCRYPTED_KEYS=y

# ── network filesystems ───────────────────────────────────────────────────────
# NFS_FS is already =y from the defconfig. CIFS is not, and SMB is what a shared
# drive on a home network almost always is.
CONFIG_CIFS=m
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
CONFIG_CIFS_UPCALL=y
CONFIG_CIFS_DFS_UPCALL=y

# ── observability ─────────────────────────────────────────────────────────────
# kprobes underpins perf probe, bpftrace and most BPF tooling.
# BPF_SYSCALL/BPF_JIT/DEBUG_INFO_BTF are already on for sched_ext (see
# 20-arch-userland.config), so this completes that set -- BTF without kprobes is
# half a tracing stack. FTRACE is deliberately left off: heavier, stock ALARM
# omits it too, and only the PDCharger ULOG driver wanted it.
CONFIG_KPROBES=y
CONFIG_CHECKPOINT_RESTORE=y

# ── USB peripherals a workstation plugs in ────────────────────────────────────
# USB_STORAGE, SND_USB_AUDIO, USB_ACM and USB_SERIAL are already present. These
# are the serial bridge chips, for talking to a microcontroller or a console
# cable.
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_PRINTER=m

# ============== Docker / podman gaps ==============
# Checked against docker's own check-config.sh; everything else it wants was
# already on.
#
# NF_NAT_REDIRECT      published ports (-p) via REDIRECT
# NF_TABLES_IPV6       the nftables backend both docker and firewalld default to
# BLK_DEV_THROTTLING   --device-read-bps / --device-write-bps; blkio cgroup
#                      limits silently do nothing without it
# XFRM_USER            the xfrm netlink interface; it selects XFRM_ALGO, which
#                      has no prompt of its own and cannot be requested directly
CONFIG_NF_NAT_REDIRECT=m
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_INET=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_XFRM_USER=m

# ebtables, which docker's legacy bridge networking reaches for.
# BRIDGE_NF_EBTABLES is the core; the filter and nat tables depend on the _LEGACY
# symbol instead, a separate opt-in since the nft rework.
CONFIG_BRIDGE_NF_EBTABLES=m
CONFIG_BRIDGE_NF_EBTABLES_LEGACY=m
CONFIG_BRIDGE_EBT_T_FILTER=m
CONFIG_BRIDGE_EBT_T_NAT=m

# nftables expression modules. Without them an nft ruleset using them fails to
# load at runtime rather than at install.
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NAT=m

# WireGuard. In-tree, cheap, and the obvious way to reach the device remotely.
CONFIG_WIREGUARD=m

CONFIG_XFS_FS=m
CONFIG_XFS_POSIX_ACL=y
