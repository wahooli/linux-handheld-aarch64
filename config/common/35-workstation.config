# Light-workstation use: VM host, containers, encrypted volumes, network shares.

# ── KVM host plumbing ─────────────────────────────────────────────────────────
# Without VHOST_NET guest networking falls back to userspace.
CONFIG_VHOST=m
CONFIG_VHOST_IOTLB=m
CONFIG_VHOST_NET=m
CONFIG_VHOST_VSOCK=m
CONFIG_VHOST_TASK=y

# AF_VSOCK: guest agent, libvirt console and virtiofsd without guest networking.
CONFIG_VSOCKETS=m
CONFIG_VSOCKETS_LOOPBACK=m
CONFIG_VSOCKETS_DIAG=m

# ── containers (docker / podman) ──────────────────────────────────────────────
# NF_NAT is load-bearing: without it there is no container NAT, and the error blames iptables.
CONFIG_NF_NAT=m
CONFIG_NF_NAT_MASQUERADE=y
# iptables-legacy tables depend on IP_NF_IPTABLES_LEGACY (not IP_NF_IPTABLES), which needs the
# NETFILTER_XTABLES_LEGACY bool that defconfig leaves off.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_FILTER=m
CONFIG_BRIDGE_NETFILTER=m

# The xt matches docker's own check-config.sh looks for by name.
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m

# NFT_NAT depends on NF_TABLES_IPV4 || _IPV6; defconfig sets neither.
CONFIG_NF_TABLES_IPV4=y
# (No CONFIG_NFT_CHAIN_NAT: that symbol does not exist in 7.2.)
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_COMPAT=m

CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y

# ── memory: swap on a device with no swap partition ───────────────────────────
# No swap partition in the image: zram (zstd; lzo kept for existing devices), zswap for a swap file.
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSWAP=y

# ── encrypted volumes ─────────────────────────────────────────────────────────
CONFIG_DM_CRYPT=m
# =m: a =y child of the =m BLK_DEV_DM is dropped silently.
CONFIG_DM_SNAPSHOT=m
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y
# systemd-creds, fscrypt and dm-crypt keyring support.
CONFIG_ENCRYPTED_KEYS=y

# ── network filesystems ───────────────────────────────────────────────────────
# NFS is already on from defconfig; CIFS is not.
CONFIG_CIFS=m
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
CONFIG_CIFS_UPCALL=y
CONFIG_CIFS_DFS_UPCALL=y

# ── observability ─────────────────────────────────────────────────────────────
# kprobes for perf probe and bpftrace (BTF is already on for sched_ext).
CONFIG_KPROBES=y
CONFIG_CHECKPOINT_RESTORE=y

# ── USB peripherals a workstation plugs in ────────────────────────────────────
# USB serial bridges for microcontrollers and console cables.
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_PRINTER=m

# ============== Docker / podman gaps ==============
# Gaps per docker's check-config.sh. BLK_DEV_THROTTLING: blkio limits do nothing without it.
# XFRM_USER selects XFRM_ALGO, which has no prompt.
CONFIG_NF_NAT_REDIRECT=m
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_INET=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_XFRM_USER=m

# ebtables for docker's legacy bridge; the filter/nat tables need the separate _LEGACY opt-in.
CONFIG_BRIDGE_NF_EBTABLES=m
CONFIG_BRIDGE_NF_EBTABLES_LEGACY=m
CONFIG_BRIDGE_EBT_T_FILTER=m
CONFIG_BRIDGE_EBT_T_NAT=m

# A missing nft expression module fails a ruleset at load time, not install time.
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NAT=m

CONFIG_WIREGUARD=m

CONFIG_XFS_FS=m
CONFIG_XFS_POSIX_ACL=y
