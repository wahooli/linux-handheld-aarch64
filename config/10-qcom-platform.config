# Hardware enablement fragment — Qualcomm platform bits the arm64 defconfig
# leaves off. Derived from armada-packages/kernel/config/armada-kernel.config.overrides.
#
# This is the hard-won half. Do not "clean it up" — most of these are =y rather
# than =m for a specific reason, documented where it matters.
#
# Merged onto `make defconfig` output via scripts/kconfig/merge_config.sh, then
# 20-arch-userland.config is merged on top.

# ============== DRM / display ==============
# DRM_MSM MUST be built in, not a module: as a module it loads after the
# bootloader's live panel handoff window and you get a black screen with no
# other symptom. Everything it depends on therefore has to be =y as well.
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_SCHED=y
CONFIG_DRM_GPUVM=y
CONFIG_DRM_EXEC=y
CONFIG_DRM_DISPLAY_DP_HELPER=y
CONFIG_DRM_DISPLAY_DP_AUX_BUS=y
CONFIG_DRM_DISPLAY_DSC_HELPER=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_BRIDGE_CONNECTOR=y
CONFIG_DRM_PANEL_BRIDGE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y

# ============== the Odin 3 panel ==============
# The board DTS declares compatible = "chipone,icna3520" (dts/cq8725s-ayn-odin3.dts),
# so this driver IS the display. It comes from patches/0028-*, and must be =y for
# the same handoff reason as DRM_MSM.
#
# The driver `depends on BACKLIGHT_CLASS_DEVICE`, which arm64 defconfig leaves at
# =m — a =m dependency silently caps the panel at =m, and merge_config exits 0
# while doing it. Force the dependency built-in too.
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_CHIPONE_ICNA35XX=y

# ============== Qualcomm platform ==============
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_UBWC_CONFIG=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_PBS=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_FASTRPC=y
CONFIG_IOMMU_IO_PGTABLE=y
CONFIG_TRACE_GPU_MEM=y

# ============== Clocks / PHY (SM8750) ==============
# PHY_QCOM_QMP is a `menuconfig` and defconfig leaves it =m. Children cannot be
# =y under an =m parent, so the parent has to be forced first — otherwise all
# three below silently stay unset.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_EDP=y

# ============== IPC / remoteproc plumbing ==============
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_PDR_MSG=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_APR=y
CONFIG_MHI_BUS=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QRTR_TUN=y
CONFIG_QRTR_MHI=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_CTRL=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
# QCOM_PMIC_GLINK `depends on TYPEC`, which defconfig leaves =m. Same trap as
# the panel/backlight pair above: the dependency caps the dependent.
CONFIG_TYPEC=y
CONFIG_QCOM_PMIC_GLINK=y
# CONFIG_QCOM_PMIC_PDCHARGER_ULOG has NEVER applied and cannot as configured:
# it depends on RPMSG (we have it) AND EVENT_TRACING, which needs CONFIG_FTRACE.
# Stock ALARM does not enable FTRACE either, so this was inherited aspiration.
# It only logs ADSP PDCharger firmware messages — useful for charging bring-up,
# not worth the whole tracing subsystem. To get it: CONFIG_FTRACE=y and
# CONFIG_ENABLE_DEFAULT_TRACERS=y, then re-add the line below.
# CONFIG_QCOM_PMIC_PDCHARGER_ULOG=m

# ============== WCN7860 Wi-Fi + Bluetooth ==============
# Pinned rather than inherited. The arm64 defconfig happens to enable all of
# this today, but this repo carries six patches that exist solely to make
# WCN7860 work (0039-0045: ath12k hardware definition, QDSS config, PCI pwrctrl
# pwrseq, power-sequencing, and the Bluetooth qca support). Leaving the symbols
# they depend on unpinned means the config-verification loop in the PKGBUILD
# never checks them: a future defconfig that drops or renames one would still
# apply all six patches, still build green, and produce a device with no
# Bluetooth and no indication of why.
#
# =m throughout for anything that can be a module. None of this is needed before
# the rootfs is mounted -- unlike DRM_MSM above, which has to be =y to catch the
# bootloader's panel handoff -- so there is no reason to carry it in the Image.
#
# The bool sub-options below are =y because Kconfig gives them no other choice;
# they are attributes of their parent tristate, not separate modules.

# Bluetooth core. BT_QCA is the module that request_firmware()s the WCN7860
# blobs (qca/gngbtfw20.mbn and qca/gngbtnv20.bin), neither of which ships in
# upstream linux-firmware -- see docs/PATCHES.md. It has no prompt of its own and
# is selected by BT_HCIUART_QCA; it is pinned anyway so the verification loop
# guards the one module the firmware is useless without.
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_QCA=m
CONFIG_BT_HIDP=m
# bool: serdev is how the UART-attached controller binds from DT, and QCA is the
# vendor protocol on top of it. Both are attributes of BT_HCIUART, not modules.
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
# BT_HCIUART_SERDEV depends on this, and the defconfig builds it in.
CONFIG_SERIAL_DEV_BUS=y

# Wi-Fi. ath12k reaches the WCN7860 over PCIe; there is no separate ATH12K_PCI
# symbol, PCI support is part of ATH12K itself (it `depends on PCI`).
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_ATH12K=m

# Power sequencing. The WCN7860 shares a PMU between its Wi-Fi and Bluetooth
# halves and will not come up without it; patches 0042 and 0043 are what teach
# these two drivers about this part. PCI_PWRCTRL_PWRSEQ is selected by ATH12K
# when HAVE_PWRCTRL, pinned here for the same guard reason as BT_QCA.
CONFIG_POWER_SEQUENCING_QCOM_WCN=m
CONFIG_PCI_PWRCTRL_PWRSEQ=m

# ============== Boot storage: UFS ==============
# SCSI_UFS_QCOM MUST be built in. The generic UFSHCD core and BLK_DEV_SD were
# already =y, which makes this look fine at a glance, but the Qualcomm glue is
# what actually binds the DT node -- as a module, with no initramfs to load it
# from, there is no root device and the kernel panics on mount. The Odin 3
# profile deliberately ships no initramfs, so =m here is not a degraded boot,
# it is no boot. It was inherited from defconfig and never pinned.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y

# ============== Clock controllers behind DRM_MSM ==============
# The DRM section above states that everything DRM_MSM depends on has to be =y.
# These three were left at =m, so the display was builtin while the clocks it
# needs were not. armada builds all of them in for the same reason.
CONFIG_SM_DISPCC_8750=y
CONFIG_SM_GPUCC_8750=y
CONFIG_SM_TCSRCC_8750=y

# ============== Odin 3 peripherals its DTS actually names ==============
# Each of these has a compatible in dts/cq8725s-ayn-odin3.dts* and a patch in
# this series, and none of them were enabled. The patches applied, the build went
# green, and the hardware was dead:
#
#   rsinput        -> no gamepad          (patches 0031, 0508, 1002, 1300)
#   hv-haptics     -> no rumble           (patches 1000, 1001, 1003, 1004)
#   aw88166        -> no speaker output   (patch 0032)
#   heroic,htr3212 -> no RGB              (patch 0030)
#
# =m throughout: none is needed before the rootfs is mounted.
CONFIG_JOYSTICK_RSINPUT=m
CONFIG_INPUT_QCOM_HV_HAPTICS=m
CONFIG_SND_SOC_AW88166=m
CONFIG_LEDS_HTR3212=m
# LEDS_HTR3212 depends on LEDS_CLASS && I2C and selects REGMAP_I2C; the gamepad
# needs the serdev bus, same as the Bluetooth controller above.
CONFIG_LEDS_CLASS=y
CONFIG_I2C=y
