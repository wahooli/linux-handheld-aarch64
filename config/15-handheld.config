# Handheld and gaming behaviour that is architecture-independent.
#
# Most of this is adopted from armada-packages/kernel/config/armada-kernel.config.overrides,
# which carries its own reasons inline; they are reproduced here rather than
# referenced, because a config line whose justification lives in another
# project's repo is a line nobody will dare change later.
#
# Merged after the Qualcomm platform fragment and before the Arch userland one.

# ============== Proton / Wine ==============
# NTSYNC implements Windows NT synchronisation primitives in the kernel, which
# is what Proton uses in place of the esync/fsync eventfd hacks. It is off in the
# arm64 defconfig. For a device whose entire purpose is running Windows games
# through FEX + Proton this is the single highest-value option in this file.
CONFIG_NTSYNC=m

# ============== Per-game CPU QoS ==============
# uclamp lets userspace pin a minimum (or maximum) utilisation per cgroup, which
# is how a session manager keeps a game's render thread off the little cores
# without resorting to fixed frequencies. armada's powerd sets cpu.uclamp.min per
# game; gamescope and scx schedulers can use it too.
#
# This is also the half of the scheduler story the OGC patch block does not
# provide: those change how the scheduler balances, uclamp is how userspace tells
# it what to care about. TASK_GROUP is the cgroup-v2 interface -- without it the
# knobs exist but are not per-cgroup, which is the only form anything uses.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# ============== Memory pressure ==============
# MGLRU. On a device with fixed, non-expandable RAM running a compositor, a game
# and an Android runtime at once, the multi-generational LRU is a large win on
# reclaim behaviour. LRU_GEN alone only builds it -- LRU_GEN_ENABLED is what
# turns it on without a boot parameter.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# zram lives in 35-workstation.config, which already owns that decision and is
# merged after this file. Setting it here as well only produced a fragment that
# silently lost -- the compression default is changed there instead.

# ============== Firmware loading ==============
# linux-firmware ships xz- and zstd-compressed blobs now. Without these the
# loader silently fails to find firmware that is present on disk, which is a
# miserable thing to debug -- it looks identical to the firmware being absent.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# ============== Removable media ==============
# Handhelds live on SD cards, and those cards arrive formatted by Windows, by a
# camera, or by another console. exFAT and NTFS3 were already on; these are the
# pieces that make them actually usable.
#
# UNICODE provides the case-folding tables exFAT and ext4 casefold need. The NLS
# codepages are what FAT mounts use to render non-ASCII filenames -- without a
# matching codepage the mount succeeds and the filenames are mojibake.
CONFIG_UNICODE=y
CONFIG_MSDOS_FS=m
CONFIG_NLS_CODEPAGE_850=m
CONFIG_NLS_ISO8859_15=m
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_F2FS_FS_LZ4=y

# ============== Controllers ==============
# 25-controllers.config covers the main vendors. Razer is here rather than there
# because it is specifically the Kishi-style phone/handheld clamp controllers
# that matter on this device, not Razer's desktop peripherals.
CONFIG_HID_RAZER=m
