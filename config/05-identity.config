# Kernel identity.
#
# Merged FIRST so 20-arch-userland.config keeps the last word on everything
# else, per the ordering convention documented in that file.
#
# Without a LOCALVERSION this kernel installs its modules to
# /usr/lib/modules/7.2.1/ -- the same path a stock linux-aarch64 7.2.1 would
# use. We already declare conflicts=('linux-aarch64') so both cannot be
# installed at once, but an ambiguous module directory is still the wrong thing
# to leave on a device you are debugging: `uname -r` should say which kernel
# you are actually running. With this, it says 7.2.1-handheld.
#
# LOCALVERSION_AUTO=n keeps a "+" from being appended when the tree looks like
# a dirty git checkout, which would otherwise make the module path depend on
# whether the builder happened to leave a .git around.
CONFIG_LOCALVERSION="-handheld"
# CONFIG_LOCALVERSION_AUTO is not set
