# EL2 / Yoga Slim 7x symbols, re-asserted on top of base.config.
#
# All of these are already set in the running kernel, so on an unmodified
# base.config this fragment changes nothing. It exists because the PKGBUILD
# verifies every symbol a fragment requests and fails the build if one did not
# survive -- so a refreshed base, or a kernel bump that renames something, cannot
# silently drop them. Each line is a thing that stops working without it.

# efivars at EL2: TZ only accepts SCM buffers registered as SHM bridges.
# Applies at EL1 too (normal HLOS ownership) -- verified no regression.
CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE=y
# CONFIG_QCOM_TZMEM_MODE_GENERIC is not set

# Speakers. Without it the four WSA884x amps never leave shutdown and audio is
# silent with no error anywhere.
CONFIG_RESET_GPIO=y

# Hardware video decode. =m because VIDEO_DEV is a module.
CONFIG_VIDEO_QCOM_IRIS=m
# iris's clock/power supplier, =y so it exists before iris probes instead of
# racing the deferred-probe timeout.
CONFIG_SM_VIDEOCC_8550=y

# SCMI raw-mode debugfs for the cpufreq investigation (COEX, or cpufreq is
# inhibited).
CONFIG_ARM_SCMI_RAW_MODE_SUPPORT=y
CONFIG_ARM_SCMI_RAW_MODE_SUPPORT_COEX=y

# Persistent console store for the intermittent-freeze forensics. Pairs with
# patch 0026, which adds the ramoops region to the EL2 DT.
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# IT8987 EC driver (patch 0028) -- keyboard backlight off in suspend.
CONFIG_EC_QCOM_X1E_IT8987=m
