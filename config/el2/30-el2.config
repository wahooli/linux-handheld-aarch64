# EL2/Yoga symbols re-asserted over the base, so the per-symbol verification guards them.

# efivars at EL2: TZ only accepts SCM buffers registered as SHM bridges.
CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE=y
# CONFIG_QCOM_TZMEM_MODE_GENERIC is not set

# Without it the WSA884x amps stay in shutdown: silent audio, no error.
CONFIG_RESET_GPIO=y

# Hardware video decode. =m because VIDEO_DEV is a module.
CONFIG_VIDEO_QCOM_IRIS=m
# =y so iris's clock supplier exists before iris probes.
CONFIG_SM_VIDEOCC_8550=y

# IT8987 EC driver (patch 0028) -- keyboard backlight off in suspend.
CONFIG_EC_QCOM_X1E_IT8987=m

# Flips the base: the driverless GMU node blocks gcc/gpucc sync_state, pinning GDSCs on so CX never
# powers off in s2idle. Runtime equivalent: fw_devlink.sync_state=timeout.
CONFIG_FW_DEVLINK_SYNC_STATE_TIMEOUT=y

# Patch 0247: stops the ADSP's ~100 Hz power-limits timer in s2idle; autoloads via rpmsg modalias.
CONFIG_QCOM_ADSP_PWR_LMTS=m
