# EL2 / Yoga Slim 7x symbols, re-asserted on top of base.config.
#
# All already set in the running kernel, so on an unmodified CONFIG_BASE this
# fragment changes nothing. It exists so the PKGBUILD's per-symbol verification
# covers them: a refreshed base, or a bump that renames one, cannot drop it
# silently. Each line is something that stops working without it.

# efivars at EL2: TZ only accepts SCM buffers registered as SHM bridges. No
# regression at EL1.
CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE=y
# CONFIG_QCOM_TZMEM_MODE_GENERIC is not set

# Without it the four WSA884x amps never leave shutdown and audio is silent with
# no error anywhere.
CONFIG_RESET_GPIO=y

# Hardware video decode. =m because VIDEO_DEV is a module.
CONFIG_VIDEO_QCOM_IRIS=m
# iris's clock/power supplier, =y so it exists before iris probes rather than
# racing the deferred-probe timeout.
CONFIG_SM_VIDEOCC_8550=y

# SCMI raw-mode debugfs for the cpufreq investigation. COEX, or cpufreq is
# inhibited.
CONFIG_ARM_SCMI_RAW_MODE_SUPPORT=y
CONFIG_ARM_SCMI_RAW_MODE_SUPPORT_COEX=y

# Persistent console store for the intermittent-freeze forensics. Pairs with
# patch 0026, which adds the ramoops region to the EL2 DT.
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# IT8987 EC driver (patch 0028) -- keyboard backlight off in suspend.
CONFIG_EC_QCOM_X1E_IT8987=m
