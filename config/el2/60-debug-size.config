# On top of shared/46. Keeps DEBUG_FS, PM_DEBUG, printk and stack traces for hardware diagnosis.

# Also removes the slub_debug= boot option.
# CONFIG_SLUB_DEBUG is not set
# CONFIG_DEBUG_DEVRES is not set

# No dynamic_debug/control: dev_dbg needs a *.local.config override.
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_DYNAMIC_DEBUG_CORE is not set

