# EL2 size trimming, in addition to shared/46-debug-off.config.
# Preserve DEBUG_FS, PM_DEBUG, printk and stack traces for hardware diagnosis.
# sched_ext/debug-info policy lives in 20-features.config.

# Allocator checks and resource bookkeeping. Disabling SLUB_DEBUG also removes
# the slub_debug boot option; normal allocation and hardening stay enabled.
# CONFIG_SLUB_DEBUG is not set
# CONFIG_DEBUG_DEVRES is not set

# Dynamic debug callsites and their metadata throughout built-in code/modules.
# Normal printk warnings/errors remain; dynamic_debug/control is unavailable.
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_DYNAMIC_DEBUG_CORE is not set

# Driver and filesystem debug code inherited from the distro base.
# CONFIG_FW_LOADER_DEBUG is not set
# CONFIG_PNP_DEBUG_MESSAGES is not set
# CONFIG_SCSI_DEBUG is not set
# CONFIG_DM_DEBUG is not set
# CONFIG_MLX4_DEBUG is not set
# CONFIG_ATH5K_DEBUG is not set
# CONFIG_ATH9K_DEBUGFS is not set
# CONFIG_ATH9K_HTC_DEBUGFS is not set
# CONFIG_ATH9K_COMMON_DEBUG is not set
# CONFIG_ATH6KL_DEBUG is not set
# CONFIG_B43_DEBUG is not set
# CONFIG_B43LEGACY_DEBUG is not set
# CONFIG_IWLEGACY_DEBUG is not set
# CONFIG_IWLWIFI_DEBUG is not set
# CONFIG_RTLWIFI_DEBUG is not set
# CONFIG_USB_SERIAL_DEBUG is not set
# CONFIG_NFS_DEBUG is not set
# CONFIG_SUNRPC_DEBUG is not set
# CONFIG_CIFS_DEBUG is not set
# CONFIG_DLM_DEBUG is not set
