# Features the el2 base config does not have, because ALARM's kernel does not.
#
# base.config is a snapshot of the running kernel, which is the right default for
# "match what boots today" -- but it also inherits ALARM's omissions. These are
# the ones worth closing, and each has a cost worth knowing.

# MGLRU. Off in ALARM's config; on for handheld. Better reclaim behaviour under
# pressure, and LRU_GEN_ENABLED makes it active without a sysfs write at boot.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# Transparent hugepages. ALARM disables them outright, so the running kernel has
# none. MADVISE rather than ALWAYS: the same mode handheld ends up with, and the
# one that does not raise the memory footprint of every process.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set

# sched_ext, so scx schedulers (scx_lavd and friends) are loadable at runtime.
#
# THE COST, stated plainly: SCHED_CLASS_EXT depends on DEBUG_INFO_BTF, which
# needs real (non-reduced, non-absent) debug info. ALARM's config sets
# CONFIG_DEBUG_INFO_NONE, so turning this on turns debug info ON -- which makes
# vmlinux large and the -headers package with it (handheld's is 171 MB, mostly
# this). Build time goes up too. If that trade is wrong for this machine, delete
# this block: nothing else here depends on it.
#
# pahole must be present at build time; it is in the Dockerfile.
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y
