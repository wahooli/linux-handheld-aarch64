# Features ALARM's config, and so the base snapshot, lacks.

# MGLRU, active without a sysfs write.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# ALARM disables THP; MADVISE does not grow every process.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set

# sched_ext: ALARM sets DEBUG_INFO_NONE, so this turns debug info on (bigger vmlinux, slower build).
# BPF asserted so the verification names the cause if a base drops one.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y

# --- parity with what the handheld product enables ---------------------------
# Laptop-relevant symbols handheld's fragments request; NTSYNC and uclamp are in shared/45.

# Shareable buffers for iris and Adreno.
CONFIG_DMABUF_HEAPS=y

# Finds .zst firmware blobs.
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# zram with zstd, for swap on a 16 GB laptop.
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# UTF-8 FAT default so the ESP needs no iocharset.
CONFIG_EROFS_FS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_FAT_DEFAULT_UTF8=y

# Force feedback for the Steam Controller (HID_STEAM is already on here).
CONFIG_STEAM_FF=y

# ALARM disables it; without it the UEFI RTCInfo offset never follows NTP and boots come up stale.
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_SYSTOHC_DEVICE="rtc0"

# efibc's SetVariable returns EFI_UNSUPPORTED after hibernation; efivarfs is unaffected.
# CONFIG_EFI_BOOTLOADER_CONTROL is not set

# /dev/drm_dp_auxN for reading panel DPCD. Renamed from DRM_DP_AUX_CHARDEV.
CONFIG_DRM_DISPLAY_DP_AUX_CHARDEV=y

# bootstatus says whether the last reset was the watchdog; sbsa_gwdt resets silently (one stage, 10 s).
CONFIG_WATCHDOG_SYSFS=y
