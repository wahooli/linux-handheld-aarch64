# Features the el2 base config does not have, because ALARM's kernel does not.
#
# CONFIG_BASE is a snapshot of the running kernel, which also inherits ALARM's
# omissions. These are the ones worth closing.

# MGLRU. Off in ALARM's config, on for handheld. LRU_GEN_ENABLED makes it active
# without a sysfs write at boot.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# ALARM disables transparent hugepages outright. MADVISE rather than ALWAYS --
# the same mode handheld ends up with, and the one that does not raise the memory
# footprint of every process.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set

# sched_ext, so scx schedulers are loadable at runtime.
#
# The cost: SCHED_CLASS_EXT depends on DEBUG_INFO_BTF, which needs real debug
# info, and ALARM's config sets DEBUG_INFO_NONE. So this turns debug info on,
# making vmlinux and the -headers package much larger and the build slower.
# Delete this block if that trade is wrong here; nothing else depends on it.
#
# pahole must be present at build time; it is in the Dockerfile.
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y

# --- parity with what the handheld product enables ---------------------------
# el2 builds from ALARM's config and merges no common/handheld fragments, so 25
# symbols those request were unset here. Most are Odin 3 hardware and stay out;
# these are the ones a laptop wants. (NTSYNC and uclamp live in
# config/shared/45-userland.config -- both products want them.)

# dma-buf heaps: userspace allocation of shareable buffers, used by the media and
# graphics stacks -- this machine has both, iris and Adreno.
CONFIG_DMABUF_HEAPS=y

# linux-firmware is moving from .xz to .zst; without this the loader does not
# find a .zst blob.
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# zram with zstd, for swap on a 16 GB laptop.
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# EROFS (appimage/flatpak images), zstd-compressed squashfs, and UTF-8 as the FAT
# default so the ESP needs no explicit iocharset.
CONFIG_EROFS_FS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_FAT_DEFAULT_UTF8=y

# Force feedback for the Steam Controller (HID_STEAM is already on here).
CONFIG_STEAM_FF=y

# RTC writeback. ALARM turns RTC_SYSTOHC off; Kconfig defaults it on. Without it
# nothing pushes the NTP-synced time back into the RTC, so the offset pm8xxx keeps
# in the UEFI RTCInfo variable only moved on a manual hwclock --systohc and boots
# came up weeks stale. Firmware derives its own clock from that same variable, so
# this keeps the date shown in UEFI setup current as well.
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_SYSTOHC_DEVICE="rtc0"

# efibc calls EFI runtime SetVariable directly, which returns EFI_UNSUPPORTED
# here when recording the reboot reason after hibernation. Disable that
# bootloader notifier; Qualcomm uefisecapp/efivarfs support remains enabled.
# CONFIG_EFI_BOOTLOADER_CONTROL is not set

# DPCD poking from userspace (/dev/drm_dp_auxN). Debug aid for the post-resume
# dark-panel hunt: the eDP link trains and the stream runs, so the open
# questions are all "what does the panel's DPCD actually say" -- e.g. whether
# DP_EDP_BACKLIGHT_ENABLE (0x720) is set, which cannot be answered at all
# without this. Read-only unless written to; no runtime cost.
# Symbol is DRM_DISPLAY_DP_AUX_CHARDEV (drivers/gpu/drm/display/Kconfig), not
# the older DRM_DP_AUX_CHARDEV. It lives inside `if DRM_DISPLAY_HELPER`, which
# is already =y here, and selects DRM_DISPLAY_DP_HELPER (also already =y).
CONFIG_DRM_DISPLAY_DP_AUX_CHARDEV=y

# Watchdog sysfs: state, timeleft, and above all bootstatus, which carries
# WDIOF_CARDRESET ("card previously reset the CPU") -- the one read that says
# outright whether the last reset came from the watchdog. Without this the
# watchdog class dir has only dev/uevent and the question is unanswerable
# without opening /dev/watchdog, which on most drivers ARMS it.
#
# Needed because 1c840000.watchdog (sbsa_gwdt) registers with a 10s timeout and
# action=0 -- single-stage, so WS0 is ignored and WS1 hard-resets the SoC with
# no panic, no interrupt and no console output. That is invisible to every
# exception and interrupt crumb in 0110/0111/0112, and it is the leading
# explanation for the hibernate-with-Bluetooth-on reset.
CONFIG_WATCHDOG_SYSFS=y
