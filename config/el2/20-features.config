# Features the el2 base config does not have, because ALARM's kernel does not.
#
# CONFIG_BASE is a snapshot of the running kernel, which also inherits ALARM's
# omissions. These are the ones worth closing.

# MGLRU. Off in ALARM's config, on for handheld. LRU_GEN_ENABLED makes it active
# without a sysfs write at boot.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# ALARM disables transparent hugepages outright. MADVISE rather than ALWAYS --
# the same mode handheld ends up with, and the one that does not raise the memory
# footprint of every process.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set

# sched_ext, so scx schedulers are loadable at runtime.
#
# The cost: SCHED_CLASS_EXT depends on DEBUG_INFO_BTF, which needs real debug
# info, and ALARM's config sets DEBUG_INFO_NONE. So this turns debug info on,
# making vmlinux and the -headers package much larger and the build slower.
# Delete this block if that trade is wrong here; nothing else depends on it.
#
# pahole must be present at build time; it is in the Dockerfile.
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y

# --- parity with what the handheld product enables ---------------------------
# el2 builds from ALARM's config and merges no common/handheld fragments, so 25
# symbols those request were unset here. Most are Odin 3 hardware and stay out;
# these are the ones a laptop wants. (NTSYNC and uclamp live in
# config/shared/45-userland.config -- both products want them.)

# dma-buf heaps: userspace allocation of shareable buffers, used by the media and
# graphics stacks -- this machine has both, iris and Adreno.
CONFIG_DMABUF_HEAPS=y

# linux-firmware is moving from .xz to .zst; without this the loader does not
# find a .zst blob.
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# zram with zstd, for swap on a 16 GB laptop.
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# EROFS (appimage/flatpak images), zstd-compressed squashfs, and UTF-8 as the FAT
# default so the ESP needs no explicit iocharset.
CONFIG_EROFS_FS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_FAT_DEFAULT_UTF8=y

# Force feedback for the Steam Controller (HID_STEAM is already on here).
CONFIG_STEAM_FF=y
