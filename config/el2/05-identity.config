# Kernel identity for the el2 product.
#
# The running kernel says "-ARCH" because it IS ALARM's linux-aarch64, rebuilt
# with the EL2 patches. This product is its own package that installs BESIDE the
# stock kernel, so it needs its own module directory: /usr/lib/modules/<ver>-el2
# rather than a path a stock 7.2.2 would also claim. `uname -r` then answers
# which kernel is booted, which on a machine being bisected is the point.
#
# This is the ONE flag deliberately different from the running config.
CONFIG_LOCALVERSION="-el2"
# CONFIG_LOCALVERSION_AUTO is not set
