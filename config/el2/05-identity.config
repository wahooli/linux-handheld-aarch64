# Kernel identity for the el2 product.
#
# This product installs beside the stock kernel, so it needs its own module
# directory rather than a path a stock kernel of the same version would claim --
# and `uname -r` then answers which kernel is booted.
#
# The one flag deliberately different from the running config.
CONFIG_LOCALVERSION="-el2"
# CONFIG_LOCALVERSION_AUTO is not set
